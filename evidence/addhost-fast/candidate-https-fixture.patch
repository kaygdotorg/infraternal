+++ b/crates/infraternal-server/src/bootstrap_payload_candidates.rs
@@ -0,0 +1,52 @@
+//! Measures optional pinned HTTPS delivery through the existing test listener; public payloads and pins only (#190).
+
+use axum::{Router, routing::get};
+use bytes::Bytes;
+use std::{path::Path, sync::OnceLock};
+use infraternal_plugin_ssh::{transport::{Input, shell_quote}};
+
+static FETCH: OnceLock<(String, String)> = OnceLock::new();
+
+/// Add a diagnostic public asset only for the explicitly selected candidate run.
+pub(super) async fn attach(router: Router, binary: &Path, certificate: &openssl::x509::X509) -> Router {
+    if std::env::var_os("BREAKIT2_HTTPS_CANDIDATE").is_none() { return router; }
+    let file = std::fs::File::open(binary).unwrap();
+    let output = tokio::process::Command::new("/usr/bin/gzip")
+        .args(["-n", "-9", "-c"])
+        .stdin(file).stderr(std::process::Stdio::null()).kill_on_drop(true)
+        .output().await.unwrap();
+    assert!(output.status.success());
+    let bytes = Bytes::from(output.stdout);
+    println!("METRIC candidate_fetch encoded_bytes={}", bytes.len());
+    FETCH.set(("https://addhost-breakit2.test:4929/breakit2/payload".into(), String::from_utf8(certificate.to_pem().unwrap()).unwrap())).unwrap();
+    router.route("/breakit2/payload", get(move || { let bytes = bytes.clone(); async move { bytes } }))
+}
+
+/// Replace only a compressed public upload; invitation/private stdin is untouched.
+pub(super) fn script(script: &str, input: &Input<'_>) -> Option<String> {
+    if !matches!(input, Input::Bytes(_)) || !script.contains("gzip -dc > \"$stage/payload\"") { return None; }
+    let (url, pin) = FETCH.get()?;
+    Some(script.replace("gzip -dc > \"$stage/payload\"", &format!("python3 -I -c {} {} {} > \"$stage/payload\"", shell_quote(FETCH_SCRIPT), shell_quote(url), shell_quote(pin))))
+}
+
+// Isolated Python imports only system libraries. Hostname/validity/key proof and
+// the exact pinned HTTPS leaf remain mandatory, as in the shipping join client.
+// Streaming keeps the target body bounded; the existing raw SHA256 check still
+// precedes publication or execution. This module is a candidate fixture only.
+const FETCH_SCRIPT: &str = r"import gzip, ssl, sys, urllib.request
+context = ssl.create_default_context(cadata=sys.argv[2])
+context.verify_flags = ssl.VERIFY_DEFAULT | ssl.VERIFY_X509_PARTIAL_CHAIN
+request = urllib.request.Request(sys.argv[1])
+opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), urllib.request.HTTPSHandler(context=context))
+with opener.open(request, timeout=10) as response:
+    assert response.status == 200
+    with gzip.GzipFile(fileobj=response) as payload:
+        total = 0
+        while True:
+            chunk = payload.read(65536)
+            if not chunk:
+                break
+            total += len(chunk)
+            assert total <= 64 * 1024 * 1024
+            sys.stdout.buffer.write(chunk)
+";
