+    /// The actor never waits for plugin joins while publishing promotion.
+    pub(crate) async fn promote(&self) -> io::Result<()> {
+        self.admit_operation().await?;
+        let priming = self
+            .priming
+            .lock()
+            .map_err(|_| io::ErrorKind::Other)?
+            .take()
+            .ok_or(io::ErrorKind::InvalidInput)?;
+        priming
