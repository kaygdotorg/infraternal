			     fd4d:3686:d1a7::3c2,
			     fd4d:3686:d1a7::3c3,
			     fd4d:3686:d1a7::3c4,
			     fd4d:3686:d1a7::3c5,
			     fd4d:3686:d1a7::3c6,
			     fd4d:3686:d1a7::3c7,
			     fd4d:3686:d1a7::3c8,
			     fd4d:3686:d1a7::3c9,
			     fd4d:3686:d1a7::3ca,
			     fd4d:3686:d1a7::3cb,
			     fd4d:3686:d1a7::3cc,
			     fd4d:3686:d1a7::3cd,
			     fd4d:3686:d1a7::3ce,
			     fd4d:3686:d1a7::3cf,
			     fd4d:3686:d1a7::3d0,
			     fd4d:3686:d1a7::3d1,
			     fd4d:3686:d1a7::3d2,
			     fd4d:3686:d1a7::3d3,
			     fd4d:3686:d1a7::3d4,
			     fd4d:3686:d1a7::3d5,
			     fd4d:3686:d1a7::3d6,
			     fd4d:3686:d1a7::3d7,
			     fd4d:3686:d1a7::3d8,
			     fd4d:3686:d1a7::3d9,
			     fd4d:3686:d1a7::3da,
			     fd4d:3686:d1a7::3db,
			     fd4d:3686:d1a7::3dc,
			     fd4d:3686:d1a7::3dd,
			     fd4d:3686:d1a7::3de,
			     fd4d:3686:d1a7::3df,
			     fd4d:3686:d1a7::3e0,
			     fd4d:3686:d1a7::3e1,
			     fd4d:3686:d1a7::3e2,
			     fd4d:3686:d1a7::3e3,
			     fd4d:3686:d1a7::3e4,
			     fd4d:3686:d1a7::3e5,
			     fd4d:3686:d1a7::3e6,
			     fd4d:3686:d1a7::3e7,
			     fd4d:3686:d1a7::3e8 }
	}

	set outgoing6_tcp {
		type ipv6_addr . inet_service
	}

	set outgoing6_udp {
		type ipv6_addr . inet_service
	}

	chain incoming {
		ct state established,related accept
		ip saddr @incoming4_all accept
		ip saddr . tcp dport @incoming4_tcp accept
		ip saddr . udp dport @incoming4_udp accept
		ip6 saddr @incoming6_all accept
		ip6 saddr . tcp dport @incoming6_tcp accept
		ip6 saddr . udp dport @incoming6_udp accept
		drop
	}

	chain outgoing {
		ct state established,related accept
		ip daddr @outgoing4_all accept
		ip daddr . tcp dport @outgoing4_tcp accept
		ip daddr . udp dport @outgoing4_udp accept
		ip6 daddr @outgoing6_all accept
		ip6 daddr . tcp dport @outgoing6_tcp accept
		ip6 daddr . udp dport @outgoing6_udp accept
		drop
	}

	chain input {
		type filter hook input priority filter - 10; policy accept;
		iifname != { "lo", "infraternal0" } ip daddr 10.254.0.1 drop
		iifname != { "lo", "infraternal0" } ip6 daddr fd4d:3686:d1a7::1 drop
		iifname "infraternal0" jump incoming
	}

	chain output {
		type filter hook output priority filter - 10; policy accept;
		oifname "infraternal0" jump outgoing
	}

	chain forward {
		type filter hook forward priority filter - 10; policy accept;
		iifname != { "lo", "infraternal0" } ip daddr 10.254.0.1 drop
		iifname != { "lo", "infraternal0" } ip6 daddr fd4d:3686:d1a7::1 drop
		iifname "infraternal0" drop
		oifname "infraternal0" drop
	}

	chain ingress {
		type filter hook prerouting priority raw - 10; policy accept;
		iifname != { "lo", "infraternal0" } ip daddr 10.254.0.1 drop
		iifname != { "lo", "infraternal0" } ip6 daddr fd4d:3686:d1a7::1 drop
	}
}
