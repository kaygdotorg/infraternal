			     fda3:baf9:dcd3::3c2,
			     fda3:baf9:dcd3::3c3,
			     fda3:baf9:dcd3::3c4,
			     fda3:baf9:dcd3::3c5,
			     fda3:baf9:dcd3::3c6,
			     fda3:baf9:dcd3::3c7,
			     fda3:baf9:dcd3::3c8,
			     fda3:baf9:dcd3::3c9,
			     fda3:baf9:dcd3::3ca,
			     fda3:baf9:dcd3::3cb,
			     fda3:baf9:dcd3::3cc,
			     fda3:baf9:dcd3::3cd,
			     fda3:baf9:dcd3::3ce,
			     fda3:baf9:dcd3::3cf,
			     fda3:baf9:dcd3::3d0,
			     fda3:baf9:dcd3::3d1,
			     fda3:baf9:dcd3::3d2,
			     fda3:baf9:dcd3::3d3,
			     fda3:baf9:dcd3::3d4,
			     fda3:baf9:dcd3::3d5,
			     fda3:baf9:dcd3::3d6,
			     fda3:baf9:dcd3::3d7,
			     fda3:baf9:dcd3::3d8,
			     fda3:baf9:dcd3::3d9,
			     fda3:baf9:dcd3::3da,
			     fda3:baf9:dcd3::3db,
			     fda3:baf9:dcd3::3dc,
			     fda3:baf9:dcd3::3dd,
			     fda3:baf9:dcd3::3de,
			     fda3:baf9:dcd3::3df,
			     fda3:baf9:dcd3::3e0,
			     fda3:baf9:dcd3::3e1,
			     fda3:baf9:dcd3::3e2,
			     fda3:baf9:dcd3::3e3,
			     fda3:baf9:dcd3::3e4,
			     fda3:baf9:dcd3::3e5,
			     fda3:baf9:dcd3::3e6,
			     fda3:baf9:dcd3::3e7,
			     fda3:baf9:dcd3::3e8 }
	}

	set outgoing6_tcp {
		type ipv6_addr . inet_service
	}

	set outgoing6_udp {
		type ipv6_addr . inet_service
	}

	chain incoming {
		ct state established,related accept
		ip saddr @incoming4_all accept
		ip saddr . tcp dport @incoming4_tcp accept
		ip saddr . udp dport @incoming4_udp accept
		ip6 saddr @incoming6_all accept
		ip6 saddr . tcp dport @incoming6_tcp accept
		ip6 saddr . udp dport @incoming6_udp accept
		drop
	}

	chain outgoing {
		ct state established,related accept
		ip daddr @outgoing4_all accept
		ip daddr . tcp dport @outgoing4_tcp accept
		ip daddr . udp dport @outgoing4_udp accept
		ip6 daddr @outgoing6_all accept
		ip6 daddr . tcp dport @outgoing6_tcp accept
		ip6 daddr . udp dport @outgoing6_udp accept
		drop
	}

	chain input {
		type filter hook input priority filter - 10; policy accept;
		iifname != { "lo", "infraternal0" } ip daddr 10.254.0.1 drop
		iifname != { "lo", "infraternal0" } ip6 daddr fda3:baf9:dcd3::1 drop
		iifname "infraternal0" jump incoming
	}

	chain output {
		type filter hook output priority filter - 10; policy accept;
		oifname "infraternal0" jump outgoing
	}

	chain forward {
		type filter hook forward priority filter - 10; policy accept;
		iifname != { "lo", "infraternal0" } ip daddr 10.254.0.1 drop
		iifname != { "lo", "infraternal0" } ip6 daddr fda3:baf9:dcd3::1 drop
		iifname "infraternal0" drop
		oifname "infraternal0" drop
	}

	chain ingress {
		type filter hook prerouting priority raw - 10; policy accept;
		iifname != { "lo", "infraternal0" } ip daddr 10.254.0.1 drop
		iifname != { "lo", "infraternal0" } ip6 daddr fda3:baf9:dcd3::1 drop
	}
}
