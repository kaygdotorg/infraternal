<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Embedded in the macOS infraternal binary as its __TEXT,__info_plist section (build.rs, #576).
     macOS reads it for the Local Network alert and the Privacy & Security entry of the user-mode
     infraternal agent, and codesign takes the signing identifier from CFBundleIdentifier. Keep
     CFBundleIdentifier equal to macos_user_mode::BUNDLE_IDENTIFIER. -->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>org.infraternal.infraternal</string>
	<key>CFBundleName</key>
	<string>infraternal</string>
	<key>CFBundleDisplayName</key>
	<string>infraternal</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>infraternal connects directly to your other devices on this network.</string>
</dict>
</plist>
