#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-only
# Run each namespace case under the perf VM's shared lock and root scope (#260).
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH
kit=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
cd "$kit"
[[ $(id -un) == claude ]] || { echo 'run as claude on the perf VM' >&2; exit 2; }
runner=${PERF_RUN:-/usr/local/bin/perf-run}
cases=("$@")
((${#cases[@]})) || cases=(mesh-underlay mesh-infraternal mesh-tailscale mesh-gotatun mesh-boringtun mesh-wireguard-go mesh-netbird mesh-netbird-userspace term-local term-wan term-loss term-scale)
out=$kit/results/$(date -u +%Y%m%dT%H%M%SZ)
mkdir -p "$out/receipts"
rc=0
for name in "${cases[@]}"; do
    "$runner" --root --out "$out/receipts" -- env H2H_LOCK=external H2H_USER=claude \
        H2H_RESULTS="$out" bash "$kit/run.sh" --only "$name" \
        --label "perf VM $(hostname), $(uname -m); perf.slice CPUs 1–3, 6 GiB" || rc=1
done
echo "results: $out"
exit "$rc"
