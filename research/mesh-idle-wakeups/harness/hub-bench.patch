+//! Root-only measurement of one mesh node acting as a hub for many peers (#260, J1234).
+//!
+//! The measured node is a real [`Node`] on the `GotaTun` engine: the same snapshot apply, TUN,
+//! route and packet-filter programming a shipping agent runs. It does not start a coordinator;
+//! the test hands it snapshots exactly as the coordinator would (`deliver`).
+//!
+//! Run it as root inside a network namespace with an underlay veth to the peer simulator
+//! (`research/many-peer-hub/harness/run.py` builds the namespaces and drives it). The test
+//! blocks on a FIFO named by `HUB_FIFO`, so an idle hub has no polling thread of its own, and it
+//! appends one JSON line per command to `HUB_OUT`. Commands, one per line:
+//!
+//! - `identity`: write `identity.json` (the node's public key and port) into `HUB_DIR`;
+//! - `apply <file>`: read the peer list `<file>` (JSON `[{"id":n,"key":"hex","endpoint":"ip:port"}]`, the endpoint optional), build the
+//!   complete snapshot and deliver it under a new authority epoch; reports the apply time;
+//! - `change <id>`: re-deliver the same list with peer `<id>` given a different inbound policy,
+//!   so exactly one peer differs; reports the apply time;
+//! - `counters`: time `Node::counters` for the whole peer set;
+//! - `trace`: report how many of each `GotaTun` timer trace event fired since the last `trace`
+//!   (only with `HUB_TRACE=1`; J1253 wakeup attribution);
+//! - `exit`: take the node down and end the test.
+//!
+//! It only reports; it never asserts on the measured numbers.
+#![allow(clippy::unwrap_used)]
+#![allow(clippy::expect_used)]
+use super::*;
+use crate::{
+    dataplane::{DefaultPolicy, Peer, PeerPolicy},
+    policy::model::{Addresses, NodeId, PublicKey},
+};
+use std::{
+    io::{BufRead as _, Write as _},
+    path::PathBuf,
+    sync::{Arc, Mutex},
+    time::Instant,
+};
+
+/// The hub's own mesh address.
+const HUB_IPV4: &str = "10.254.0.1";
+
+/// Decode a 64-character hex string into a 32-byte key.
+fn key_from_hex(hex: &str) -> PublicKey {
+    let mut bytes = [0_u8; 32];
+    for (index, byte) in bytes.iter_mut().enumerate() {
+        *byte = u8::from_str_radix(&hex[index * 2..index * 2 + 2], 16).unwrap();
+    }
+    PublicKey(bytes)
+}
+
+/// Mesh addresses of simulated peer `id`: 10.254.(1 + id/256).(id%256) and fd01::1:<id>.
+fn addresses(id: u64) -> Addresses {
+    let high = u8::try_from(1 + id / 256).unwrap();
+    let low = u8::try_from(id % 256).unwrap();
+    Addresses {
+        ipv4: std::net::Ipv4Addr::new(10, 254, high, low),
+        ipv6: format!("fd01::1:{id:x}").parse().unwrap(),
+    }
+}
+
+/// A peer that allows everything both ways. Without an endpoint the peer dials the hub; with one
+/// (the coordinator's candidate) the hub also knows where to answer.
+fn peer_policy(
+    key: PublicKey,
+    id: u64,
+    endpoint: Option<std::net::SocketAddr>,
+    candidates: Vec<std::net::SocketAddr>,
+    closed_inbound: bool,
+) -> PeerPolicy {
+    PeerPolicy {
+        peer: Peer {
+            key,
+            previous_key: None,
+            previous_active: false,
+            addresses: addresses(id),
+            endpoint,
+            candidates,
+            ipv4_only: false,
+            side_port: false,
+        },
+        inbound: if closed_inbound {
+            crate::policy::rules::TrafficPolicy::None
+        } else {
+            crate::policy::rules::TrafficPolicy::All
+        },
+        outbound: crate::policy::rules::TrafficPolicy::All,
+        access_ssh: None,
+        networks: crate::dataplane::PeerNetworks::default(),
+    }
+}
+
+/// One listed peer: its id, key, configured endpoint and further candidate addresses.
+type Listed = (
+    u64,
+    PublicKey,
+    Option<std::net::SocketAddr>,
+    Vec<std::net::SocketAddr>,
+);
+
+/// Build the complete snapshot for the hub; `closed` names the one peer whose inbound policy is
+/// closed, if any.
+fn hub_snapshot(
+    local_key: PublicKey,
+    list: &[Listed],
+    closed: Option<u64>,
+    version: u64,
+) -> Config {
+    Config {
+        authority_epoch: Some(format!("00000000-0000-4000-8000-{version:012x}")),
+        rotation_operation: None,
+        local_key: Some(local_key),
+        server: None,
+        node: NodeId(1),
+        #[cfg(feature = "mesh-dns")]
+        name: None,
+        #[cfg(feature = "mesh-dns")]
+        dns_suffix: "internal".to_owned(),
+        version,
+        addresses: Addresses {
+            ipv4: HUB_IPV4.parse().unwrap(),
+            ipv6: "fd01::1".parse().unwrap(),
+        },
+        default_policy: DefaultPolicy::Deny,
+        exposure: None,
+        peers: list
+            .iter()
+            .map(|(id, key, endpoint, candidates)| {
+                (
+                    NodeId(*id + 1),
+                    peer_policy(
+                        *key,
+                        *id,
+                        *endpoint,
+                        candidates.clone(),
+                        closed == Some(*id),
+                    ),
+                )
+            })
+            .collect(),
+        #[cfg(feature = "mesh-dns")]
+        peer_names: BTreeMap::new(),
+    }
+}
+
+/// Deliver every chunk of `config`, stamped with its epoch.
+///
+/// Returns the chunk count, the time the coordinator side needed to encode the chunks, and the
+/// time the node needed to take them. Only the second is the node's cost; a coordinator encodes
+/// the snapshot on the server, not on the node.
+fn deliver(node: &mut Node, config: &Config) -> (usize, u64, u64) {
+    let encoding = Instant::now();
+    let chunks = crate::configuration::chunks(None, config).unwrap();
+    let encode_us = u64::try_from(encoding.elapsed().as_micros()).unwrap();
+    let count = chunks.len();
+    let applying = Instant::now();
+    for mut chunk in chunks {
+        chunk.authority_epoch.clone_from(&config.authority_epoch);
+        node.chunk(chunk).unwrap();
+    }
+    (
+        count,
+        encode_us,
+        u64::try_from(applying.elapsed().as_micros()).unwrap(),
+    )
+}
+
+/// Read the peer list file written by the simulator.
+fn read_list(path: &str) -> Vec<Listed> {
+    let value: serde_json::Value = serde_json::from_slice(&std::fs::read(path).unwrap()).unwrap();
+    value
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|entry| {
+            (
+                entry["id"].as_u64().unwrap(),
+                key_from_hex(entry["key"].as_str().unwrap()),
+                entry["endpoint"].as_str().map(|text| text.parse().unwrap()),
+                entry["candidates"]
+                    .as_array()
+                    .map(|list| {
+                        list.iter()
+                            .map(|text| text.as_str().unwrap().parse().unwrap())
+                            .collect()
+                    })
+                    .unwrap_or_default(),
+            )
+        })
+        .collect()
+}
+
+/// Counts `GotaTun`'s timer and handshake trace events by their message text (up to the first
+/// colon), so an idle window can say which timer fired how often (J1253). Only installed with
+/// `HUB_TRACE=1`: formatting every event costs CPU, so measured wakeup rates come from runs
+/// without it.
+struct TraceCounts(Arc<Mutex<BTreeMap<String, u64>>>);
+
+/// Picks the `message` field out of one event.
+struct Message(String);
+
+impl tracing::field::Visit for Message {
+    /// Keep the formatted message; other fields do not matter here.
+    fn record_debug(&mut self, field: &tracing::field::Field, value: &dyn std::fmt::Debug) {
+        if field.name() == "message" {
+            self.0 = format!("{value:?}");
+        }
+    }
+}
+
+impl tracing::Subscriber for TraceCounts {
+    /// Only the engine's protocol events are counted.
+    fn enabled(&self, metadata: &tracing::Metadata<'_>) -> bool {
+        metadata.target().starts_with("gotatun::noise")
+    }
+
+    /// Spans are not used; any id will do.
+    fn new_span(&self, _: &tracing::span::Attributes<'_>) -> tracing::span::Id {
+        tracing::span::Id::from_u64(1)
+    }
+
+    /// Spans are not used.
+    fn record(&self, _: &tracing::span::Id, _: &tracing::span::Record<'_>) {}
+
+    /// Spans are not used.
+    fn record_follows_from(&self, _: &tracing::span::Id, _: &tracing::span::Id) {}
+
+    /// Count one event by its message, cut at the first colon (which precedes per-peer values).
+    fn event(&self, event: &tracing::Event<'_>) {
+        let mut message = Message(String::new());
+        event.record(&mut message);
+        let key = message.0.split(':').next().unwrap_or_default().to_owned();
+        *self.0.lock().unwrap().entry(key).or_insert(0_u64) += 1;
+    }
+
+    /// Spans are not used.
+    fn enter(&self, _: &tracing::span::Id) {}
+
+    /// Spans are not used.
+    fn exit(&self, _: &tracing::span::Id) {}
+}
+
+/// Run the hub until it reads `exit` from `HUB_FIFO`.
+#[test]
+#[ignore = "Run as root inside a dedicated network namespace, driven by research/many-peer-hub"]
+fn many_peer_hub() {
+    let dir = PathBuf::from(std::env::var_os("HUB_DIR").unwrap());
+    let out_path = std::env::var_os("HUB_OUT").unwrap();
+    let fifo = std::env::var_os("HUB_FIFO").unwrap();
+    let state = dir.join("hub-state");
+    std::fs::create_dir_all(&state).unwrap();
+    std::fs::set_permissions(&state, std::os::unix::fs::PermissionsExt::from_mode(0o700)).unwrap();
+    let mut node = Node::restore_with_engine(&state, EngineKind::GotaTun).unwrap();
+    let identity = node.up().unwrap();
+    let mut out = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(out_path)
+        .unwrap();
+    let trace_counts = Arc::new(Mutex::new(BTreeMap::new()));
+    if std::env::var_os("HUB_TRACE").is_some() {
+        tracing::subscriber::set_global_default(TraceCounts(Arc::clone(&trace_counts))).unwrap();
+    }
+    let mut version = 10_u64;
+    let mut list: Vec<Listed> = Vec::new();
+    // Opening a FIFO for reading blocks until the driver opens it for writing.
+    let reader = std::io::BufReader::new(std::fs::File::open(fifo).unwrap());
+    for line in reader.lines() {
+        let line = line.unwrap();
+        let mut words = line.split_whitespace();
+        let command = words.next().unwrap_or("");
+        let argument = words.next().unwrap_or("");
+        let mut result = serde_json::json!({ "cmd": command });
+        match command {
+            "identity" => {
+                std::fs::write(
+                    dir.join("identity.json"),
+                    serde_json::to_vec(&identity).unwrap(),
+                )
+                .unwrap();
+            }
+            "apply" | "change" => {
+                if command == "apply" {
+                    list = read_list(argument);
+                }
+                let closed = (command == "change").then(|| argument.parse::<u64>().unwrap());
+                version += 1;
+                let config = hub_snapshot(identity.public_key, &list, closed, version);
+                let (chunks, encode_us, apply_us) = deliver(&mut node, &config);
+                result["apply_us"] = apply_us.into();
+                result["encode_us"] = encode_us.into();
+                result["chunks"] = chunks.into();
+                result["peers"] = list.len().into();
+            }
+            "counters" => {
+                let started = Instant::now();
+                let counters = node.counters().unwrap();
+                result["counters_us"] =
+                    u64::try_from(started.elapsed().as_micros()).unwrap().into();
+                result["counted_peers"] = counters.len().into();
+            }
+            "exit" => {
+                node.down().unwrap();
+                result["down"] = true.into();
+                writeln!(out, "{result}").unwrap();
+                break;
+            }
+            "trace" => {
+                let counts = std::mem::take(&mut *trace_counts.lock().unwrap());
+                result["events"] = serde_json::to_value(counts).unwrap();
+            }
+            other => result["error"] = format!("unknown command {other}").into(),
+        }
+        writeln!(out, "{result}").unwrap();
+        out.flush().unwrap();
+    }
+}
