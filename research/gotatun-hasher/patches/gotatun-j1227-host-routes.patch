+    /// A reference model: the plain trie. The hybrid must answer every query as the trie does,
+    /// through inserts, replacements, nested prefixes and removals (J1227).
+    #[test]
+    fn host_routes_agree_with_a_plain_trie() {
+        let mut state = 0x9E37_79B9_7F4A_7C15u64;
+        let mut next = move || {
+            state ^= state << 13;
+            state ^= state >> 7;
+            state ^= state << 17;
+            state
+        };
+        for _ in 0..30 {
+            let mut hybrid: AllowedIps<u32> = AllowedIps::new();
+            let mut trie: IpNetworkTable<u32> = IpNetworkTable::new();
+            for step in 0..2000u32 {
+                let ip = if next() % 3 == 0 {
+                    IpAddr::from((0xfd00u128 << 112 | u128::from(next() % 40)).to_be_bytes())
+                } else {
+                    IpAddr::from([10, (next() % 3) as u8, 0, (next() % 40) as u8])
+                };
+                let full = if ip.is_ipv4() { 32 } else { 128 };
+                match next() % 10 {
+                    0..=4 => {
+                        let cidr = if next() % 3 == 0 { (next() % (full + 1)) as u8 } else { full as u8 };
+                        let net = ip_network::IpNetwork::new_truncate(ip, cidr).unwrap();
+                        assert_eq!(hybrid.insert(ip, cidr, step), trie.insert(net, step));
+                    }
+                    5 => {
+                        let m = 2 + (next() % 4) as u32;
+                        hybrid.remove(&|v| v % m == 0);
+                        trie.retain(|_, v| *v % m != 0);
+                    }
+                    _ => {}
+                }
+                for _ in 0..6 {
+                    let q = if next() % 3 == 0 {
+                        IpAddr::from((0xfd00u128 << 112 | u128::from(next() % 48)).to_be_bytes())
+                    } else {
+                        IpAddr::from([10, (next() % 3) as u8, 0, (next() % 48) as u8])
+                    };
+                    assert_eq!(hybrid.find(q), trie.longest_match(q).map(|(_, d)| d));
+                }
+            }
+        }
+    }
