+/// The hasher family under test (J1204, #260): per-process random seed, so the slot of a tuple is
+/// not predictable from outside (the product's `DefaultHasher::new()` uses fixed zero keys).
+type FlowHashState = foldhash::fast::RandomState;
+
+/// One process-wide seeded state shared by the flow and fragment tables.
+fn flow_hash_state() -> &'static FlowHashState {
+    static STATE: std::sync::OnceLock<FlowHashState> = std::sync::OnceLock::new();
+    STATE.get_or_init(FlowHashState::default)
+}
