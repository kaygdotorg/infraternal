#!/usr/bin/env python3
"""Root entry point of the nightly browser suite system unit on dev-02 (D373, #443).

Installed root-owned at /usr/local/libexec/infraternal-browser-suite-service by
`scripts/install-nightly-browser-suite`; systemd runs it as root. Like the
fuzz helper it runs no repository code as root, and it keeps the Forgejo
token away from the code under test:

1. holds one shared build slot per Playwright shard (SHARDS, two) as `claude` (through `runuser`) until the workload exits.
   The scheduled service bounds checkout and suite execution at 07:45 IST, then reports after releasing the slots.
   Waiting for the slot has its own bound (QUEUE_WAIT_SECONDS): on a timeout
   the unit fails with exit 75 and one `QUEUE WAIT TIMEOUT` journal line, and no
   suite runs. The suite's own budget (`timeout`, 9 h) starts only after the
   slot is granted; a timeout is exit 124 and one `SUITE TIMEOUT` line;
2. as `infraternal-browser` (no token, no sudo): fetches the newest origin/dev
   (hooks off) and runs `scripts/nightly-browser-suite.py run` in the dev shell,
   niced, then kills whatever that account still runs;
3. as root, copies the run's result files into a staging folder (created
   by descriptor, never following a link) that belongs to the token account. Everything in the run folder is hostile (the
   suite wrote it), so each file is opened without following links, must be a
   regular file owned by the suite account and under a size cap, and is
   written out as a fresh private copy;
4. checks the staged copies are all there;
5. as `infraternal-fuzz` (the account that holds the token): runs the
   root-owned, reviewed copy of the reporter on the staged copies only. It
   publishes one merged report atomically before posting issues;
6. as root, publishes the log, raw results, merged report and evidence to a
   root-owned, read-only run folder. The whole folder appears at once by
   directory rename, and only after every source file passes the same hostile
   data checks used for staging.

`infraternal-browser-suite-service --report-only [--run-name NAME]` (as root) runs
the reporter again on the files already staged in `browser-staging`, then
publishes the checked report for operators to read. It takes no slot, runs no
suite and stages no new files. Use it to file a night's results after fixing
the token or login. `--run-name` is needed for staging left by an older helper
(it has no `staged.json`); otherwise the name comes from there.

The Forgejo account the token belongs to is configured by the installer in
`/etc/infraternal-browser-suite.login` (root-owned) and handed to the reporter:
the token deliberately lacks the `read:user` scope, so the reporter cannot ask Forgejo.

Its exit status is 1 when the build or the suite could not run, a result file
was refused, or a report could not be filed; failing specs that were filed
are a success, as in the fuzz.
"""
import os
import pwd
import re
import argparse
import datetime
import json
import shutil
import signal
import stat
import subprocess
import sys
import threading
import time
import tempfile
from pathlib import Path

BROWSER_USER = 'infraternal-browser'
BROWSER_HOME = '/var/lib/infraternal-browser'
PUBLISH_HOME = '/var/lib/infraternal-browser-pub'
REPORT_USER = 'infraternal-fuzz'
REPORT_HOME = '/var/lib/infraternal-fuzz'
REPORTER = '/usr/local/libexec/infraternal-browser-suite-report'
BUILD_SLOT = '/home/claude/infraternal-ops/build-slot'
READY = b'INFRATERNAL_BROWSER_SLOT_READY\n'
# Two separate budgets, so a long build-slot queue can never look like a suite failure (#443):
# the wait for a slot, and the suite itself (which starts only once a slot is held).
# The unit's own TimeoutStartSec (24 h) is only a backstop above both plus the report.
QUEUE_WAIT_SECONDS = 12 * 3600
# One build slot per Playwright shard, so the nightly is counted like the jobs it runs next to (equals `SHARDS` in nightly-browser-suite.py).
SHARDS = 2
SUITE_BUDGET = '9h'
DEADLINE_REASON = 'deadline-0745-ist'
IST = datetime.timezone(datetime.timedelta(hours=5, minutes=30))
QUEUE_TIMEOUT_EXIT = 75
SUITE_TIMEOUT_EXIT = 124
# What the suite may leave in a run folder, and the most the helper will copy of each. `results.json` and
# `results.jsonl` are each optional (a suite stopped by its budget has only the streamed lines), but one must exist.
CAPS = {'meta.json': 64 << 10, 'results.json': 32 << 20, 'results.jsonl': 32 << 20, 'suite.log': 16 << 20}
OPTIONAL = ('results.json', 'results.jsonl')
PUBLISH_FILE_CAP = 128 << 20
PUBLISH_TOTAL_CAP = 1 << 30
PUBLISH_ENTRY_CAP = 20000
PUBLISH_DEPTH_CAP = 16
PUBLISH_KEEP_RUNS = 7
MERGED_REPORT = 'merged-report.json'
MERGED_REPORT_CAP = 32 << 20
LOGIN_FILE = '/etc/infraternal-browser-suite.login'
LOGIN_OWNER = 0
LOGIN = re.compile(r'\A[A-Za-z0-9][A-Za-z0-9._-]{0,38}\Z', re.ASCII)
# This dedicated uid runs only this suite. Descendants may create new process
# groups, so sweep the uid's groups after the timed workload exits.
KILL_SNIPPET = """import os, signal
from pathlib import Path

uid, own = os.getuid(), os.getpgrp()
groups = set()
for path in Path('/proc').iterdir():
    if not path.name.isdecimal():
        continue
    try:
        if any(line.split()[2] == str(uid) for line in (path / 'status').read_text().splitlines()
               if line.startswith('Uid:')):
            group = os.getpgid(int(path.name))
            if group > 1 and group != own:
                groups.add(group)
    except ProcessLookupError:
        pass
    except FileNotFoundError:
        pass
for group in groups:
    try:
        os.killpg(group, signal.SIGKILL)
    except ProcessLookupError:
        pass
"""
KILL_COMMAND = ['/usr/bin/python3', '-c', KILL_SNIPPET]
RUN_NAME = re.compile(r'\A[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7}\Z', re.ASCII)
PATH = 'PATH=/nix/var/nix/profiles/default/bin:/usr/local/bin:/usr/bin:/bin'


class Refused(Exception):
    """A run folder or file that is not what an honest suite run leaves behind."""


class Missing(Refused):
    """The file is simply not there (an optional result file, say)."""


def ids(user):
    """The numeric user and group id of an account."""
    entry = pwd.getpwnam(user)
    return entry.pw_uid, entry.pw_gid


def read_login(path, owner):
    """The Forgejo account name from the root-owned config file, or Refused.

    The file must be a plain file owned by `owner` (root) and hold one
    plausible account name. It is read without following links.
    """
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError as error:
        raise Refused(f'{path}: {error.strerror}') from error
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != owner or info.st_size > 256:
            raise Refused(f'{path}: not a small regular file owned by root')
        text = os.read(descriptor, 300).decode(errors='replace')
    finally:
        os.close(descriptor)
    name = text[:-1] if text.endswith('\n') else text
    if not LOGIN.fullmatch(name):
        raise Refused(f'{path}: does not hold a Forgejo account name')
    return name


def run_is_from_tonight(name, since):
    """Whether the run folder `name` was made at or after `since` (a UTC datetime), allowing a minute of slack.

    The suite names its folder after the time it started, so a `latest` that is
    older than this helper's own start belongs to an earlier night.
    """
    try:
        stamp = datetime.datetime.strptime(name[:16], '%Y%m%dT%H%M%SZ').replace(tzinfo=datetime.timezone.utc)
    except ValueError:
        return False
    return stamp >= since - datetime.timedelta(minutes=1)


def write_staged_info(destination, name, suite_timeout, chown_to):
    """Leave `staged.json` in the staging folder, so `--report-only` knows which run these files are from."""
    descriptor = os.open('staged.json', os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=destination)
    with os.fdopen(descriptor, 'w') as handle:
        handle.write(json.dumps({'run_name': name, 'suite_timeout': suite_timeout}) + '\n')
        if chown_to:
            os.fchown(handle.fileno(), *chown_to)


def as_user(user, home, *command, cwd):
    """Run `command` as `user` with a clean environment and return the exit status.

    `cwd` is entered by `env -C` *after* `setpriv` has dropped privileges. Root
    itself stays in `/`: the suite account owns its checkout and could make it
    a link, and a root `chdir` would follow that link.
    """
    return subprocess.run(['setpriv', f'--reuid={user}', f'--regid={user}', '--init-groups', '--reset-env', '--',
                           'env', '-C', cwd, f'HOME={home}', 'LANG=C.UTF-8', PATH, *command], cwd='/').returncode


def read_owned(directory, name, cap, owner, tail=False):
    """Read one regular file of `directory` (an open descriptor) owned by `owner`, never following links.

    Opened with O_NOFOLLOW and O_NONBLOCK, so a symlink is refused and a FIFO
    cannot hang the helper; then `fstat` on the open descriptor, so nothing
    can be swapped in after the check. A file over `cap` is refused, except a
    log (`tail=True`), where the last `cap` bytes are kept.
    """
    try:
        descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=directory)
    except FileNotFoundError as error:
        raise Missing(f'{name}: {error.strerror}') from error
    except OSError as error:
        raise Refused(f'{name}: {error.strerror}') from error
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != owner or info.st_nlink != 1:
            raise Refused(f'{name}: not a regular, singly named file owned by the suite account')
        if info.st_size > cap:
            if not tail:
                raise Refused(f'{name}: larger than {cap} bytes')
            os.lseek(descriptor, info.st_size - cap, os.SEEK_SET)
        data = b''
        while len(data) <= cap:
            chunk = os.read(descriptor, 1 << 20)
            if not chunk:
                break
            data += chunk
        return data[:cap]
    finally:
        os.close(descriptor)


def open_directory(parent, name):
    """Open a subdirectory by name, refusing a symlink in its place."""
    try:
        return os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=parent)
    except OSError as error:
        raise Refused(f'{name}: {error.strerror}') from error


def latest_name(runs, owner):
    """The run folder name the suite left in `runs/latest`, which must have the shape of a run folder."""
    try:
        root = os.open(runs, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as error:
        raise Refused(f'runs: {error.strerror}') from error
    try:
        text = read_owned(root, 'latest', 128, owner).decode(errors='replace')
    finally:
        os.close(root)
    name = text[:-1] if text.endswith('\n') else text
    if not RUN_NAME.fullmatch(name):
        raise Refused('latest does not name a run folder')
    return name


def fresh_staging(home, chown_to):
    """Create an empty private staging folder in the token account's `home`; return it as an open descriptor.

    That home belongs to the token account, so nothing here goes by path: the
    home is opened without following a link, the old folder is removed through
    that descriptor, the new one is made and opened with O_NOFOLLOW, and only
    then given to `chown_to` with `fchown`. The caller closes the descriptor.
    """
    parent = os.open(home, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        try:
            os.unlink('browser-staging', dir_fd=parent)
        except IsADirectoryError:
            shutil.rmtree('browser-staging', dir_fd=parent)
        except FileNotFoundError:
            pass
        os.mkdir('browser-staging', 0o700, dir_fd=parent)
        staging = os.open('browser-staging', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=parent)
    finally:
        os.close(parent)
    os.fchown(staging, *chown_to)
    return staging


def stage(runs, name, destination, owner, chown_to):
    """Copy a run's result files into the open directory `destination` as private regular files, or raise Refused.

    `owner` is the suite account's uid; the run folder and each file must
    belong to it. `chown_to` is the `(uid, gid)` that gets the copies, or None.
    The copies are created relative to the `destination` descriptor, never by path.
    """
    if not RUN_NAME.fullmatch(name):
        raise Refused('bad run name')
    try:
        root = os.open(runs, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as error:
        raise Refused(f'runs: {error.strerror}') from error
    try:
        run = open_directory(root, name)
    finally:
        os.close(root)
    try:
        if os.fstat(run).st_uid != owner:
            raise Refused('run folder is not owned by the suite account')
        copies = {}
        for file, cap in CAPS.items():
            try:
                copies[file] = read_owned(run, file, cap, owner, tail=(file == 'suite.log'))
            except Missing:
                if file not in OPTIONAL:
                    raise
        if not any(file in copies for file in OPTIONAL):
            raise Refused('the run left neither results.json nor results.jsonl')
    finally:
        os.close(run)
    for file, data in copies.items():
        descriptor = os.open(file, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=destination)
        with os.fdopen(descriptor, 'wb') as handle:
            handle.write(data)
            if chown_to:
                os.fchown(handle.fileno(), *chown_to)


def write_published_file(destination, name, data, publisher_uid=0, publisher_gid=0):
    """Create one complete operator-readable file owned by the publisher in a private directory."""
    descriptor = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                         0o600, dir_fd=destination)
    try:
        with os.fdopen(descriptor, 'wb') as handle:
            handle.write(data)
            handle.flush()
            os.fchown(handle.fileno(), publisher_uid, publisher_gid)
            os.fchmod(handle.fileno(), 0o640)
            os.fsync(handle.fileno())
    except BaseException:
        try:
            os.close(descriptor)
        except OSError:
            pass
        raise


def copy_evidence(source, destination, owner, budget, depth=0, publisher_uid=0, publisher_gid=0):
    """Copy an evidence tree through directory descriptors, refusing links and every non-regular object."""
    if depth > PUBLISH_DEPTH_CAP:
        raise Refused('evidence tree is nested too deeply')
    for name in sorted(os.listdir(source)):
        budget['entries'] += 1
        if budget['entries'] > PUBLISH_ENTRY_CAP or '/' in name or '..' in name:
            raise Refused('evidence tree has too many or unsafe entry names')
        try:
            info = os.stat(name, dir_fd=source, follow_symlinks=False)
        except OSError as error:
            raise Refused(f'evidence entry {name!r}: {error.strerror}') from error
        if info.st_uid != owner:
            raise Refused(f'evidence entry {name!r} is not owned by the suite account')
        if stat.S_ISDIR(info.st_mode):
            child_source = open_directory(source, name)
            try:
                current = os.fstat(child_source)
                if (current.st_dev, current.st_ino) != (info.st_dev, info.st_ino):
                    raise Refused(f'evidence directory {name!r} changed while it was opened')
                os.mkdir(name, 0o700, dir_fd=destination)
                child_destination = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=destination)
                try:
                    copy_evidence(child_source, child_destination, owner, budget, depth + 1, publisher_uid, publisher_gid)
                    os.fchown(child_destination, publisher_uid, publisher_gid)
                    os.fchmod(child_destination, 0o750)
                    os.fsync(child_destination)
                finally:
                    os.close(child_destination)
            finally:
                os.close(child_source)
        elif stat.S_ISREG(info.st_mode):
            if info.st_nlink != 1 or info.st_size > PUBLISH_FILE_CAP:
                raise Refused(f'evidence file {name!r} has too many links or is larger than {PUBLISH_FILE_CAP} bytes')
            try:
                data = read_owned(source, name, PUBLISH_FILE_CAP, owner)
            except Refused as error:
                raise Refused(f'evidence file {name!r}: {error}') from error
            budget['bytes'] += len(data)
            if budget['bytes'] > PUBLISH_TOTAL_CAP:
                raise Refused(f'evidence tree is larger than {PUBLISH_TOTAL_CAP} bytes')
            write_published_file(destination, name, data, publisher_uid, publisher_gid)
        else:
            raise Refused(f'evidence entry {name!r} is not a regular file or directory')


def staged_report(home, owner):
    """Read the reviewed reporter's atomically written merged report without following a path it controls."""
    try:
        parent = os.open(home, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as error:
        raise Refused(f'report home: {error.strerror}') from error
    try:
        if os.fstat(parent).st_uid != owner:
            raise Refused('report home is not owned by the reporter account')
        staging = open_directory(parent, 'browser-staging')
    finally:
        os.close(parent)
    try:
        if os.fstat(staging).st_uid != owner:
            raise Refused('report staging is not owned by the reporter account')
        return read_owned(staging, MERGED_REPORT, MERGED_REPORT_CAP, owner)
    finally:
        os.close(staging)


def prune_published_runs(root, publisher_uid=0):
    """Remove interrupted hidden copies and keep only the newest complete published runs."""
    published = []
    for name in os.listdir(root):
        if name.startswith('.publish-'):
            temporary = open_directory(root, name)
            try:
                info = os.fstat(temporary)
                if info.st_uid != publisher_uid or info.st_mode & 0o022:
                    raise Refused(f'interrupted publication {name} is not private and publisher-owned')
            finally:
                os.close(temporary)
            shutil.rmtree(name, dir_fd=root)
            continue
        if not RUN_NAME.fullmatch(name):
            continue
        directory = open_directory(root, name)
        try:
            info = os.fstat(directory)
            if info.st_uid != publisher_uid or info.st_mode & 0o022:
                raise Refused(f'published run {name} is not a private publisher-owned directory')
        finally:
            os.close(directory)
        published.append(name)
    for name in sorted(published)[:-PUBLISH_KEEP_RUNS]:
        shutil.rmtree(name, dir_fd=root)


def publish_run(runs, name, owner, report_home, report_owner, publish_home=PUBLISH_HOME, publisher_uid=0, publisher_gid=0):
    """Atomically publish the merged report and checked run evidence for operators to read.

    The source account ran unreviewed dev code, so the copy is built under a
    private temporary name using no-follow descriptors, owner/link checks and
    per-file and total size bounds. Files and directories are synced before a
    same-parent rename makes the whole run visible. Existing complete runs are
    left alone, making a retry safe.
    """
    if not RUN_NAME.fullmatch(name):
        raise Refused('bad run name')
    try:
        root = os.open(publish_home, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as error:
        raise Refused(f'publish directory: {error.strerror}') from error
    temporary = None
    try:
        root_info = os.fstat(root)
        if root_info.st_uid != publisher_uid or root_info.st_mode & 0o022:
            raise Refused('publish directory must be publisher-owned and not group/world writable')
        try:
            os.stat(name, dir_fd=root, follow_symlinks=False)
            exists = True
        except FileNotFoundError:
            exists = False
        if exists:
            existing = open_directory(root, name)
            try:
                info = os.fstat(existing)
                if info.st_uid != publisher_uid or info.st_mode & 0o022:
                    raise Refused(f'published run {name} is not a private publisher-owned directory')
                read_owned(existing, MERGED_REPORT, MERGED_REPORT_CAP, publisher_uid)
            finally:
                os.close(existing)
            return False

        temporary = f'.publish-{name}-{os.getpid()}-{time.monotonic_ns()}'
        os.mkdir(temporary, 0o700, dir_fd=root)
        destination = os.open(temporary, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=root)
        try:
            try:
                source_root = os.open(runs, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
            except OSError as error:
                raise Refused(f'runs: {error.strerror}') from error
            try:
                source = open_directory(source_root, name)
            finally:
                os.close(source_root)
            try:
                if os.fstat(source).st_uid != owner:
                    raise Refused('run folder is not owned by the suite account')
                budget = {'bytes': 0, 'entries': 0}
                copied_results = False
                for file, cap in CAPS.items():
                    try:
                        data = read_owned(source, file, cap, owner, tail=(file == 'suite.log'))
                    except Missing:
                        if file in OPTIONAL:
                            continue
                        raise
                    budget['bytes'] += len(data)
                    if budget['bytes'] > PUBLISH_TOTAL_CAP:
                        raise Refused(f'published run is larger than {PUBLISH_TOTAL_CAP} bytes')
                    write_published_file(destination, file, data, publisher_uid, publisher_gid)
                    copied_results = copied_results or file in OPTIONAL
                if not copied_results:
                    raise Refused('the run left neither results.json nor results.jsonl')
                evidence = open_directory(source, 'evidence')
                try:
                    if os.fstat(evidence).st_uid != owner:
                        raise Refused('evidence folder is not owned by the suite account')
                    os.mkdir('evidence', 0o700, dir_fd=destination)
                    evidence_copy = os.open('evidence', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                                            dir_fd=destination)
                    try:
                        copy_evidence(evidence, evidence_copy, owner, budget, publisher_uid=publisher_uid,
                                      publisher_gid=publisher_gid)
                        os.fchown(evidence_copy, publisher_uid, publisher_gid)
                        os.fchmod(evidence_copy, 0o750)
                        os.fsync(evidence_copy)
                    finally:
                        os.close(evidence_copy)
                finally:
                    os.close(evidence)
            finally:
                os.close(source)

            merged = staged_report(report_home, report_owner)
            budget['bytes'] += len(merged)
            if budget['bytes'] > PUBLISH_TOTAL_CAP:
                raise Refused(f'published run is larger than {PUBLISH_TOTAL_CAP} bytes')
            write_published_file(destination, MERGED_REPORT, merged, publisher_uid, publisher_gid)
            os.fchown(destination, publisher_uid, publisher_gid)
            os.fchmod(destination, 0o750)
            os.fsync(destination)
        finally:
            os.close(destination)
        try:
            os.rename(temporary, name, src_dir_fd=root, dst_dir_fd=root)
        except FileExistsError:
            shutil.rmtree(temporary, dir_fd=root)
            temporary = None
            return False
        os.fsync(root)
        temporary = None
        prune_published_runs(root, publisher_uid)
        os.fsync(root)
        return True
    finally:
        if temporary is not None:
            try:
                shutil.rmtree(temporary, dir_fd=root)
            except FileNotFoundError:
                pass
        os.close(root)


def staged_run_name(home, owner):
    """Read the current staging run name for a retry, validating its owner and format."""
    parent = os.open(home, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        staging = open_directory(parent, 'browser-staging')
    finally:
        os.close(parent)
    try:
        staged = json.loads(read_owned(staging, 'staged.json', 4096, owner))
    finally:
        os.close(staging)
    name = staged.get('run_name') if isinstance(staged, dict) else None
    if not isinstance(name, str) or not RUN_NAME.fullmatch(name):
        raise Refused('staged.json does not contain a valid run name')
    return name


def stop_holder(holder):
    """End a slot holder that is still queued: signal its whole process group, then let it go."""
    try:
        os.killpg(holder.pid, signal.SIGTERM)
    except (ProcessLookupError, PermissionError, TypeError):
        holder.terminate()


def release_holders(holders):
    """Release this service's holders before copying files or calling Forgejo."""
    while holders:
        holder = holders.pop()
        try:
            holder.stdin.write(b'x')
            holder.stdin.close()
        except BrokenPipeError:
            pass
        holder.wait()


def night_deadline(started):
    """Return 07:45 IST on the day of this activation, including late timer catch-ups."""
    return started.astimezone(IST).replace(hour=7, minute=45, second=0, microsecond=0)


def deadline_seconds(deadline):
    """Round down the remaining wall time so a timed command stops at the window edge."""
    return max(0, int((deadline - datetime.datetime.now(IST)).total_seconds()))


def publish_deadline_summary(deadline, phase):
    """Record the cutoff even when there is no usable browser manifest to stage."""
    print(f'nightly browser suite: stopped at deadline 07:45 IST during {phase}', file=sys.stderr, flush=True)
    root = Path(PUBLISH_HOME)
    with tempfile.TemporaryDirectory(prefix='.deadline-', dir=root) as directory:
        fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
        try:
            data = json.dumps({'status': 'partial', 'reason': 'stopped at deadline', 'phase': phase,
                               'deadline': deadline.isoformat()}) + '\n'
            write_published_file(fd, 'last-deadline.json', data.encode())
            os.replace(Path(directory) / 'last-deadline.json', root / 'last-deadline.json')
            root_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            try:
                os.fsync(root_fd)
            finally:
                os.close(root_fd)
        finally:
            os.close(fd)


def timed_command(command, deadline):
    """Cancel the whole timed command's group at the cutoff, including a case in flight."""
    if deadline is None:
        return command
    seconds = deadline_seconds(deadline)
    return ('timeout', '--signal=KILL', str(seconds), *command) if seconds else None


def wait_for_slot(holder, seconds=None):
    """Wait up to `seconds` (default QUEUE_WAIT_SECONDS) for the holder to say it has a slot: True, False (it died) or None (still queued).

    The wait is a short-lived reader thread, so the bound is enforced without
    touching the pipe from two places. On a timeout the holder is stopped,
    which also ends the reader.
    """
    answer = []
    reader = threading.Thread(target=lambda: answer.append(holder.stdout.readline()), daemon=True)
    reader.start()
    reader.join(QUEUE_WAIT_SECONDS if seconds is None else seconds)
    if reader.is_alive():
        stop_holder(holder)
        reader.join(5)
        return None
    return bool(answer) and answer[0] == READY


def report_step(login, name, suite_timeout=None):
    """Run the reviewed reporter as the token account on the staged files; return its exit status."""
    staging = Path(REPORT_HOME) / 'browser-staging'
    extra = ['--suite-timeout', suite_timeout] if suite_timeout else []
    return as_user(REPORT_USER, REPORT_HOME, '/usr/bin/python3', '-I', REPORTER, 'report', '--results', str(staging),
                   '--run-name', name, *extra, '--login', login, '--token-file', f'{REPORT_HOME}/forgejo-token', cwd=REPORT_HOME)


def publish_reported_run(name, owner=None, report_owner=None):
    """Publish the current reviewed merged report and checked run data for operators to inspect."""
    owner = ids(BROWSER_USER)[0] if owner is None else owner
    report_owner = ids(REPORT_USER)[0] if report_owner is None else report_owner
    created = publish_run(f'{BROWSER_HOME}/runs', name, owner, REPORT_HOME, report_owner)
    if created:
        print(f'BROWSER_RUN_PUBLISHED run={name} path={PUBLISH_HOME}/{name}', flush=True)
    else:
        print(f'BROWSER_RUN_PUBLISHED run={name} already_present={PUBLISH_HOME}/{name}', flush=True)
    return created


def main(argv=None):
    """Take a slot, run the suite without the token, report with it, release the slot (or only re-run the report, see the module doc)."""
    parser = argparse.ArgumentParser(description='Nightly browser suite service helper (D373, #443).')
    parser.add_argument('--report-only', action='store_true', help='only re-run the reporter on the files already staged')
    parser.add_argument('--run-name', default=None, help='with --report-only: the run folder name, for staging from an older helper')
    parser.add_argument('--deadline-ist', action='store_true', help='bound the scheduled run to 07:45 IST')
    args = parser.parse_args(argv)
    if args.deadline_ist and args.report_only:
        parser.error('--deadline-ist applies only when running the suite')
    if args.run_name is not None and (not args.report_only or not RUN_NAME.fullmatch(args.run_name)):
        parser.error('--run-name needs --report-only and a run folder name like 20261109T134307Z-c442500')
    try:
        login = read_login(LOGIN_FILE, LOGIN_OWNER)
    except Refused as error:
        print(f'nightly browser suite: no Forgejo login configured ({error}); the installer writes {LOGIN_FILE}', file=sys.stderr)
        return 1
    if args.report_only:
        if args.run_name is None:
            # Staged by this helper: the name is in staged.json, which the reporter reads itself.
            staging = Path(REPORT_HOME) / 'browser-staging'
            code = as_user(REPORT_USER, REPORT_HOME, '/usr/bin/python3', '-I', REPORTER, 'report', '--results', str(staging),
                           '--login', login, '--token-file', f'{REPORT_HOME}/forgejo-token', cwd=REPORT_HOME)
            try:
                name = staged_run_name(REPORT_HOME, ids(REPORT_USER)[0])
            except (Refused, OSError, ValueError) as error:
                print(f'nightly browser suite: report-only could not publish its run ({error})', file=sys.stderr)
                return code
        else:
            name = args.run_name
            code = report_step(login, name)
        try:
            publish_reported_run(name)
        except (Refused, OSError) as error:
            print(f'nightly browser suite: refusing operator report publication: {error}', file=sys.stderr)
            return 1 if code == 0 else code
        return code
    started = datetime.datetime.now(datetime.timezone.utc)
    cutoff = night_deadline(started) if args.deadline_ist else None
    holders = []
    try:
        # One slot per shard, taken one after the other under a single queue budget. Slots already held are released
        # again if a later one never comes.
        deadline = time.monotonic() + QUEUE_WAIT_SECONDS
        for _ in range(SHARDS):
            if cutoff is not None and not deadline_seconds(cutoff):
                release_holders(holders)
                publish_deadline_summary(cutoff, 'build-slot queue')
                return SUITE_TIMEOUT_EXIT
            holder = subprocess.Popen(
                ['runuser', '-u', 'claude', '--', BUILD_SLOT, '/usr/bin/python3', '-c',
                 f'import sys; sys.stdout.buffer.write({READY!r}); sys.stdout.flush(); sys.stdin.buffer.read(1)'],
                stdin=subprocess.PIPE, stdout=subprocess.PIPE, start_new_session=True)
            holders.append(holder)
            queue_seconds = max(0.0, deadline - time.monotonic())
            if cutoff is not None:
                queue_seconds = min(queue_seconds, deadline_seconds(cutoff))
            slot = wait_for_slot(holder, queue_seconds)
            if slot is None:
                if cutoff is not None and deadline_seconds(cutoff) <= 1:
                    release_holders(holders)
                    publish_deadline_summary(cutoff, 'build-slot queue')
                    return SUITE_TIMEOUT_EXIT
                print(f'nightly browser suite: QUEUE WAIT TIMEOUT: no build slot after {QUEUE_WAIT_SECONDS // 3600} h in the queue '
                      f'({len(holders) - 1} of {SHARDS} slots held); no suite ran and nothing was reported', file=sys.stderr)
                return QUEUE_TIMEOUT_EXIT
            if not slot:
                print('nightly browser suite: could not take a build slot', file=sys.stderr)
                return 1
        checkout = f'{BROWSER_HOME}/checkout'
        runs = f'{BROWSER_HOME}/runs'
        # The nightly follows the latest dev (D361/D373), so the checkout moves every night.
        git = ('sh', '-c', 'git -c core.hooksPath=/dev/null -c core.fsmonitor=false fetch --quiet origin dev '
               '&& git -c core.hooksPath=/dev/null -c core.fsmonitor=false checkout --quiet --detach origin/dev')
        checkout_command = timed_command(git, cutoff)
        status = as_user(BROWSER_USER, BROWSER_HOME, *checkout_command, cwd=checkout) if checkout_command else 0
        if cutoff is not None and deadline_seconds(cutoff) <= 1 and (not checkout_command or status in (-9, 137)):
            release_holders(holders)
            publish_deadline_summary(cutoff, 'checkout')
            return SUITE_TIMEOUT_EXIT
        if status != 0:
            return 1
        run = ('nix', 'develop', '-c', 'python3', 'scripts/nightly-browser-suite.py',
               'run', '--runs-dir', runs, '--shards', str(SHARDS))
        if cutoff is None:
            command = ('timeout', '--kill-after=60', SUITE_BUDGET, *run)
        else:
            command = timed_command(run, cutoff)
        if command is None:
            release_holders(holders)
            publish_deadline_summary(cutoff, 'suite startup')
            return SUITE_TIMEOUT_EXIT
        status = as_user(BROWSER_USER, BROWSER_HOME, 'nice', '-n', '10', *command, cwd=checkout)
        stopped_at_deadline = cutoff is not None and status in (-9, 137) and deadline_seconds(cutoff) <= 1
        # Stop this dedicated account's leftover browsers/servers before staging. No other builds use it.
        cleanup_failed = as_user(BROWSER_USER, BROWSER_HOME, *KILL_COMMAND, cwd='/') != 0
        release_holders(holders)
        if stopped_at_deadline:
            publish_deadline_summary(cutoff, 'browser suite')
        if cleanup_failed:
            print('nightly browser suite: could not stop the suite account\'s leftover processes; nothing was staged or reported', file=sys.stderr)
            return 1
        timeout_reason = DEADLINE_REASON if stopped_at_deadline else SUITE_BUDGET if status == 124 else None
        timed_out = timeout_reason is not None
        if status == 124:
            print(f'nightly browser suite: SUITE TIMEOUT: the suite did not finish within {SUITE_BUDGET} of running '
                  '(the time in the build-slot queue is not counted); reporting the tests that finished', file=sys.stderr)
        elif not timed_out and status != 0:
            return 1
        # The run account wrote everything below `runs`: treat it as data (see stage).
        owner = ids(BROWSER_USER)[0]
        reporter = ids(REPORT_USER)
        try:
            name = latest_name(runs, owner)
            if not run_is_from_tonight(name, started):
                raise Refused(f'latest names {name}, which is older than this run: the suite never made its own folder')
            descriptor = fresh_staging(REPORT_HOME, reporter)
            try:
                stage(runs, name, descriptor, owner, reporter)
                write_staged_info(descriptor, name, timeout_reason, reporter)
            finally:
                os.close(descriptor)
        except (Refused, OSError) as error:
            print(f'nightly browser suite: refusing the run folder: {error}', file=sys.stderr)
            return SUITE_TIMEOUT_EXIT if timed_out else 1
        code = report_step(login, name, timeout_reason)
        try:
            publish_reported_run(name, owner, reporter[0])
        except (Refused, OSError) as error:
            print(f'nightly browser suite: refusing operator report publication: {error}', file=sys.stderr)
            return SUITE_TIMEOUT_EXIT if timed_out else 1
        return SUITE_TIMEOUT_EXIT if timed_out else code
    finally:
        release_holders(holders)


if __name__ == '__main__':
    raise SystemExit(main())
