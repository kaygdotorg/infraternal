#!/usr/bin/env python3
"""Root entry point of the nightly browser suite system unit on dev-02 (D373, #443).

Installed root-owned at /usr/local/libexec/infraternal-browser-suite-service by
`scripts/install-nightly-browser-suite`; systemd runs it as root. Like the
fuzz helper it runs no repository code as root, and it keeps the Forgejo
token away from the code under test:

1. holds one shared build slot as `claude` (through `runuser`) until step 4 ends;
2. as `infraternal-browser` (no token, no sudo): fetches the newest origin/dev
   and runs `scripts/nightly-browser-suite.py run` in the dev shell, niced;
3. reads where that run left its results;
4. as `infraternal-fuzz` (the account that holds the token): runs the
   root-owned, reviewed copy of the reporter on those results.

Its exit status is 1 when the build or the suite could not run, or a report
could not be filed; failing specs that were filed are a success, as in the fuzz.
"""
import subprocess
import sys
from pathlib import Path

BROWSER_USER = 'infraternal-browser'
BROWSER_HOME = '/var/lib/infraternal-browser'
REPORT_USER = 'infraternal-fuzz'
REPORT_HOME = '/var/lib/infraternal-fuzz'
REPORTER = '/usr/local/libexec/infraternal-browser-suite-report'
BUILD_SLOT = '/home/claude/infraternal-ops/build-slot'
READY = b'INFRATERNAL_BROWSER_SLOT_READY\n'
PATH = 'PATH=/nix/var/nix/profiles/default/bin:/usr/local/bin:/usr/bin:/bin'


def as_user(user, home, *command, cwd):
    """Run `command` as `user` with a clean environment and return the exit status."""
    return subprocess.run(['setpriv', f'--reuid={user}', f'--regid={user}', '--init-groups', '--reset-env', '--',
                           'env', f'HOME={home}', 'LANG=C.UTF-8', PATH, *command], cwd=cwd).returncode


def main():
    """Take a slot, run the suite without the token, report with it, release the slot."""
    holder = subprocess.Popen(
        ['runuser', '-u', 'claude', '--', BUILD_SLOT, '/usr/bin/python3', '-c',
         f'import sys; sys.stdout.buffer.write({READY!r}); sys.stdout.flush(); sys.stdin.buffer.read(1)'],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    try:
        if holder.stdout.readline() != READY:
            print('nightly browser suite: could not take a build slot', file=sys.stderr)
            return 1
        checkout = f'{BROWSER_HOME}/checkout'
        runs = f'{BROWSER_HOME}/runs'
        # The nightly follows the latest dev (D361/D373), so the checkout moves every night.
        if as_user(BROWSER_USER, BROWSER_HOME, 'sh', '-c', 'git fetch --quiet origin dev && git checkout --quiet --detach origin/dev',
                   cwd=checkout) != 0:
            return 1
        if as_user(BROWSER_USER, BROWSER_HOME, 'nice', '-n', '10', 'nix', 'develop', '-c', 'python3',
                   'scripts/nightly-browser-suite.py', 'run', '--runs-dir', runs, cwd=checkout) != 0:
            return 1
        # The run account wrote this pointer, so treat it as data: it must name a directory inside `runs`.
        results = Path((Path(runs) / 'latest').read_text().strip()).resolve()
        if results.parent != Path(runs).resolve():
            print('nightly browser suite: results path outside the runs directory', file=sys.stderr)
            return 1
        return as_user(REPORT_USER, REPORT_HOME, '/usr/bin/python3', REPORTER, 'report', '--results', str(results),
                       '--token-file', f'{REPORT_HOME}/forgejo-token', cwd=REPORT_HOME)
    finally:
        try:
            holder.stdin.write(b'x')
            holder.stdin.close()
        except BrokenPipeError:
            pass
        holder.wait()


if __name__ == '__main__':
    raise SystemExit(main())
