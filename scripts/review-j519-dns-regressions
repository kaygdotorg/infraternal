#!/usr/bin/env bash
# Runs the J519 DNS regressions with disposable /etc and root Nix profile paths (#483).
set -euo pipefail

cargo_args=(test --locked -p infraternal-plugin-mesh --lib --no-default-features
    --features server,agent,mesh-dns)

if [ "${1:-}" != --inside-namespace ]; then
    test -n "${1:-}" || { echo "usage: $0 TEST_NAME" >&2; exit 2; }
    # Build with the network first: the probe's own network namespace has none.
    cargo "${cargo_args[@]}" --no-run
    exec unshare -Urnmpf --kill-child --mount-proc bash "$0" --inside-namespace "$1"
fi

test_name="${2:?name one J519 DNS regression}"
case "$test_name" in
    review_j519_restart_cleanup_removes_owned_file|review_j519_missing_tools_are_reported|review_j519_nix_profile_tool_is_discovered|review_j529_failed_cleanup_does_not_cache_previous_success|review_j485c_changed_file_invalidates_success|review_j1155_hosts_fallback_lists_and_clears_names) ;;
    *) echo "unknown J519 DNS regression: $test_name" >&2; exit 2 ;;
esac

read -r mapped_uid outside_uid mapped_count < /proc/self/uid_map
test "$mapped_uid" = 0 && test "$outside_uid" != 0 && test "$mapped_count" = 1
# Mesh DNS only tells resolved about the owned mesh link, from resolved's own network namespace
# (#584). The probe's private namespace therefore holds a marked mesh TUN and a stand-in process
# whose comm matches resolved's, and its fake resolvectl never reaches a real resolver.
ip link set lo up
ip tuntap add dev infraternal0 mode tun
ip link set dev infraternal0 alias infraternal.mesh.gotatun.v1
stand_in=$(mktemp -d)
trap 'rm -rf "$stand_in"' EXIT
printf '#!/bin/sh\nwhile :; do sleep 3600; done\n' > "$stand_in/systemd-resolved"
chmod 755 "$stand_in/systemd-resolved"
"$stand_in/systemd-resolved" &
mount --make-rprivate /
mount -t tmpfs -o mode=755,size=32m tmpfs /etc
/usr/bin/mkdir -p /tmp/j485b-private-nix-store
/usr/bin/mount --bind /nix/store /tmp/j485b-private-nix-store
/usr/bin/mount -t tmpfs -o mode=755,size=32m tmpfs /nix
/usr/bin/mkdir -p /nix/store
/usr/bin/mount --bind /tmp/j485b-private-nix-store /nix/store
mkdir -p /nix/var/nix/profiles
mkdir -p /etc/NetworkManager/dnsmasq.d

cargo "${cargo_args[@]}" --offline \
    "dns_integration::review_j519_dns::$test_name" -- --ignored --exact --nocapture
