#!/usr/bin/env bash
# Ship the full server and matching removable-component host payloads [17][20][198][201], #190.
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
if [[ $# -lt 1 || $# -gt 3 ]]; then
    printf 'usage: scripts/package-release OUTPUT [x86_64|aarch64] [--built]\n' >&2
    exit 2
fi
output="$1"
architecture="${2:-$(uname -m)}"
case "$architecture" in x86_64|aarch64) ;; *) printf 'unsupported server architecture\n' >&2; exit 2 ;; esac
if [[ -e "$output" || -L "$output" ]]; then printf 'release destination already exists\n' >&2; exit 1; fi
target="${CARGO_TARGET_DIR:-$root/target}"
[[ "$target" = /* ]] || target="$root/$target"
host_target="$target/bootstrap"
session_target="$target/session"
if [[ "${3:-}" != --built ]]; then
    scripts/auth-toolchain
    CARGO_TARGET_DIR="$host_target" scripts/auth-toolchain
    CARGO_TARGET_DIR="$session_target" scripts/auth-toolchain
    # `desktop` is not a default feature (#146): without it the server neither advertises the
    # desktop Hello capability nor links the app-window relay, so Settings → Hosts → App windows
    # stays hidden. The host payloads below stay minimal; they never serve app windows.
    scripts/static-cargo build --locked --release -p infraternal --features desktop \
        --target "$architecture-unknown-linux-musl"
    # Keep server, full node and session-only artifacts in separate Cargo roots.
    for arch in x86_64 aarch64; do
        CARGO_TARGET_DIR="$host_target" scripts/static-cargo build --locked --release -p infraternal \
            --no-default-features --features plugin-host-facts,remote,ssh \
            --target "$arch-unknown-linux-musl"
        # The early executable keeps only the verified shim and SSH bridge.
        CARGO_TARGET_DIR="$session_target" scripts/static-cargo build --locked --release -p infraternal-session \
            --target "$arch-unknown-linux-musl"
    done
fi
# Validate the complete set before publishing; a partial directory is never a release.
server="$target/$architecture-unknown-linux-musl/release/infraternal"
files=("$server")
for arch in x86_64 aarch64; do
    files+=("$host_target/$arch-unknown-linux-musl/release/infraternal")
    files+=("$session_target/$arch-unknown-linux-musl/release/infraternal-session")
done
for file in "${files[@]}"; do
    if [[ ! -x "$file" ]]; then printf 'Missing static release executable at %s\n' "$file" >&2; exit 1; fi
    readelf -h "$file" >/dev/null
    if readelf -l "$file" | rg -q INTERP; then printf 'Release payload is dynamically linked: %s\n' "$file" >&2; exit 1; fi
done
mkdir -p -- "$(dirname -- "$output")"
staging="$(mktemp -d "$(dirname -- "$output")/.release.XXXXXX")"
trap 'rm -rf -- "$staging"' EXIT
for arch in x86_64 aarch64; do
    install -m 755 "$host_target/$arch-unknown-linux-musl/release/infraternal" "$staging/infraternal-$arch-musl"
    install -m 755 "$session_target/$arch-unknown-linux-musl/release/infraternal-session" "$staging/infraternal-$arch-session-musl"
done
install -m 755 "$server" "$staging/infraternal"
install -d "$staging/licenses/libghostty-vt"
cp -R "$root/licenses/libghostty-vt/." "$staging/licenses/libghostty-vt/"
(cd "$staging" && sha256sum infraternal infraternal-*-musl licenses/libghostty-vt/* > SHA256SUMS)
mv -T -- "$staging" "$output"
printf 'Release bundle: %s (server %s; x86_64 and aarch64 host payloads)\n' "$output" "$architecture"
