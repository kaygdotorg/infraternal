#!/usr/bin/env bash
# Ship the server and both matching static host payloads in one versioned directory [17][20][205], #87.
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
if [[ $# -lt 1 || $# -gt 3 ]]; then
    printf 'usage: scripts/package-release OUTPUT [x86_64|aarch64] [--built]\n' >&2
    exit 2
fi
output="$1"
architecture="${2:-$(uname -m)}"
case "$architecture" in x86_64|aarch64) ;; *) printf 'unsupported server architecture\n' >&2; exit 2 ;; esac
if [[ -e "$output" || -L "$output" ]]; then printf 'release destination already exists\n' >&2; exit 1; fi
target="${CARGO_TARGET_DIR:-$root/target}"
[[ "$target" = /* ]] || target="$root/$target"
if [[ "${3:-}" != --built ]]; then
    scripts/auth-toolchain
    for arch in x86_64 aarch64; do cargo build --locked --release -p infraternal --target "$arch-unknown-linux-musl"; done
fi
# Validate the complete set before publishing; a partial directory is never a release.
for arch in x86_64 aarch64; do
    file="$target/$arch-unknown-linux-musl/release/infraternal"
    if [[ ! -x "$file" ]]; then printf 'Missing %s static host payload at %s\n' "$arch" "$file" >&2; exit 1; fi
    readelf -h "$file" >/dev/null
    if readelf -l "$file" | rg -q INTERP; then printf '%s payload is dynamically linked\n' "$arch" >&2; exit 1; fi
done
mkdir -p -- "$(dirname -- "$output")"
staging="$(mktemp -d "$(dirname -- "$output")/.release.XXXXXX")"
trap 'rm -rf -- "$staging"' EXIT
for arch in x86_64 aarch64; do install -m 755 "$target/$arch-unknown-linux-musl/release/infraternal" "$staging/infraternal-$arch-musl"; done
install -m 755 "$staging/infraternal-$architecture-musl" "$staging/infraternal"
(cd "$staging" && sha256sum infraternal infraternal-x86_64-musl infraternal-aarch64-musl > SHA256SUMS)
mv -T -- "$staging" "$output"
printf 'Release bundle: %s (server %s; x86_64 and aarch64 host payloads)\n' "$output" "$architecture"
