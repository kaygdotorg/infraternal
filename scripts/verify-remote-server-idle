#!/usr/bin/env bash
# Run the D81 remote fixture with loopback only and a private runtime directory.
set -euo pipefail
probe="$(dirname -- "$(realpath -- "$0")")/verify-remote-server-idle.py"
fixture="$(mktemp -d /tmp/ri.XXXXXX)"
trap 'rm -rf -- "$fixture"' EXIT
export INFRATERNAL_AGENT_TEST_STATE_ROOT="$fixture"
export PATH="/sbin:/usr/sbin:$PATH"
unshare --user --map-root-user --net --mount --pid --fork --kill-child --mount-proc bash -c '
    set -euo pipefail
    mount --make-rprivate /
    mount -t tmpfs -o mode=755 tmpfs /run
    mkdir -m 700 /run/infraternal
    ip link set lo up
    uid="$1"
    gid="$2"
    shift 2
    exec unshare --user --map-user="$uid" --map-group="$gid" python3 "$@"
' remote-server-idle "$(id -u)" "$(id -g)" "$probe" "$@"
