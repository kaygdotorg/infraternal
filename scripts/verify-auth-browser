#!/usr/bin/env bash
# Run port-free real-browser auth verification with an isolated SQLite IPC fixture [40].
set -euo pipefail
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
: "${CARGO_TARGET_DIR:=$(cd -- "${script_dir}/.." && pwd)/target}"
export CARGO_TARGET_DIR
export TRACER_TEST_PORT="${TRACER_TEST_PORT:-4621}"
python3 "${script_dir}/latency_proxy.py" self-test --samples 3
cargo build --locked --package infraternal-server --example browser_auth
bun install --cwd scripts/browser-auth --frozen-lockfile
mkdir -p "${CARGO_TARGET_DIR}/auth-rework"
bun build scripts/browser-auth/entropy.mjs --target browser --outfile "${CARGO_TARGET_DIR}/auth-rework/entropy.js"
bun run scripts/browser-auth/check.mjs
bun build scripts/browser-auth/recovery-entry.mjs --target browser --outfile "${CARGO_TARGET_DIR}/auth-rework/recovery.js"
bun run scripts/browser-auth/recovery-check.mjs
