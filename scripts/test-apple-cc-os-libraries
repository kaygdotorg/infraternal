#!/bin/sh
# Regression for #265 P2-2 and J162's F2: macOS links through .cargo/apple-cc.sh
# may load only libraries the OS ships. Run on a Mac from the repository root
# (or pass the wrapper path). It links tiny programs in a temporary directory
# and checks that the wrapper refuses a user-writable dylib or rpath, a path
# that steps out of /usr/lib, an embedded DYLD_* environment, and links whose
# output hides from an argument scan (no -o, response files, -Wl,-o), and that
# it still links an OS-only program. It also checks apple-image-check.sh on its
# own, which scripts/macos-release runs on the built binaries.
set -eu

wrapper=${1:-.cargo/apple-cc.sh}
if [ "$(/usr/bin/uname -s)" != Darwin ]; then
    printf 'run this regression on macOS\n' >&2
    exit 77
fi
wrapper=$(cd "$(dirname -- "$wrapper")" && pwd)/$(basename -- "$wrapper")
checker=$(dirname -- "$wrapper")/apple-image-check.sh

work=$(/usr/bin/mktemp -d /private/tmp/apple-cc-test.XXXXXX)
trap '/bin/rm -rf "$work"' EXIT HUP INT TERM
printf 'int helper(void) { return 0; }\n' >"$work/helper.c"
printf 'int main(void) { return 0; }\n' >"$work/plain.c"
printf 'int helper(void);\nint main(void) { return helper(); }\n' >"$work/uses.c"
/usr/bin/env -u SDKROOT -u DEVELOPER_DIR /usr/bin/clang -dynamiclib \
    -install_name "$work/libhelper.dylib" -o "$work/libhelper.dylib" "$work/helper.c"
# The same library under an install name that starts in /usr/lib and steps out.
/bin/mkdir "$work/up"
/usr/bin/env -u SDKROOT -u DEVELOPER_DIR /usr/bin/clang -dynamiclib \
    -install_name "/usr/lib/../..$work/up/libhelper.dylib" -o "$work/up/libhelper.dylib" \
    "$work/helper.c"

failed=0
expect() {
    want=$1
    label=$2
    shift 2
    set +e
    "$@" >"$work/out" 2>&1
    got=$?
    set -e
    if [ "$got" -eq "$want" ]; then
        printf 'ok   %s (exit %s)\n' "$label" "$got"
    else
        printf 'FAIL %s: want exit %s, got %s\n' "$label" "$want" "$got"
        /bin/cat "$work/out"
        failed=1
    fi
}

expect 0 'OS-only program links' "$wrapper" -o "$work/plain" "$work/plain.c"
expect 0 'TOOLCHAINS is ignored' env TOOLCHAINS=org.example.missing \
    "$wrapper" -o "$work/plain2" "$work/plain.c"
expect 1 'user-writable dylib is refused' "$wrapper" -o "$work/uses" "$work/uses.c" \
    -L"$work" -lhelper
if [ -e "$work/uses" ]; then
    printf 'FAIL refused output was left behind\n'
    failed=1
fi
expect 1 'user-writable rpath is refused' "$wrapper" -o "$work/rpath" "$work/plain.c" \
    -Wl,-rpath,/opt/homebrew/lib
printf '%s\n-o\n%s\n-L%s\n-lhelper\n' "$work/uses.c" "$work/rsp" "$work" >"$work/args"
expect 1 'response-file link is checked' "$wrapper" "@$work/args"
expect 2 'a tool other than clang is refused' env APPLE_CC_TOOL=../bin/sh \
    "$wrapper" -o "$work/tool" "$work/plain.c"
expect 0 'compile-only call passes' "$wrapper" -c -o "$work/plain.o" "$work/plain.c"
expect 0 'a version query passes' "$wrapper" --version

# J162 F2: each of these linked unchecked before the wrapper asked clang for its jobs.
expect 1 'an install name with .. is refused' "$wrapper" -o "$work/up-uses" "$work/uses.c" \
    -L"$work/up" -lhelper
expect 1 'an embedded DYLD_ environment is refused' "$wrapper" -o "$work/dyld-env" \
    "$work/plain.c" -Wl,-dyld_env,DYLD_LIBRARY_PATH="$work"
mkdir "$work/aout"
expect 1 'a link without -o is checked' sh -c 'cd "$1" && "$2" "$3" -L"$4" -lhelper' sh \
    "$work/aout" "$wrapper" "$work/uses.c" "$work"
if [ -e "$work/aout/a.out" ]; then
    printf 'FAIL refused a.out was left behind\n'
    failed=1
fi
printf -- '-o%s %s -L%s -lhelper\n' "$work/joined" "$work/uses.c" "$work" >"$work/joined.rsp"
expect 1 'a joined -o in a response file is checked' "$wrapper" "@$work/joined.rsp"
printf -- '-o\n%s\n-L%s\n-lhelper\n' "$work/nested" "$work" >"$work/inner.rsp"
printf '%s\n@%s\n' "$work/uses.c" "$work/inner.rsp" >"$work/outer.rsp"
expect 1 'a nested response file is checked' "$wrapper" "@$work/outer.rsp"
expect 1 '-Wl,-o is checked' "$wrapper" "$work/uses.c" -L"$work" -lhelper -Wl,-o,"$work/wl"
expect 1 '-Xlinker -o is checked' "$wrapper" "$work/uses.c" -L"$work" -lhelper \
    -Xlinker -o -Xlinker "$work/xl"
mkdir "$work/dash"
expect 1 'an output named -c still links and is checked' sh -c \
    'cd "$1" && "$2" -o -c "$3" -L"$4" -lhelper' sh "$work/dash" "$wrapper" "$work/uses.c" "$work"
for left in "$work/joined" "$work/nested" "$work/wl" "$work/xl" "$work/dash/-c" \
    "$work/up-uses" "$work/dyld-env"; do
    if [ -e "$left" ]; then
        printf 'FAIL refused output %s was left behind\n' "$left"
        failed=1
    fi
done

# The artifact check alone, as scripts/macos-release runs it.
expect 0 'an OS-only binary passes the image check' "$checker" "$work/plain"
/usr/bin/env -u SDKROOT -u DEVELOPER_DIR /usr/bin/clang -o "$work/raw" "$work/uses.c" \
    -L"$work" -lhelper
expect 1 'a binary built without the wrapper is refused' "$checker" "$work/raw"
expect 1 'one bad binary among several is refused' "$checker" "$work/plain" "$work/raw"
expect 2 'a file otool cannot read is refused' "$checker" "$work/plain.c"
expect 2 'a missing file is refused' "$checker" "$work/absent"
/usr/bin/sed 's#^otool=.*#otool=/nonexistent/otool#' "$checker" >"$work/no-otool.sh"
expect 2 'a missing otool is refused' sh "$work/no-otool.sh" "$work/plain"

if [ "$failed" -ne 0 ]; then
    exit 1
fi
printf 'PASS: apple-cc.sh links only OS libraries\n'
