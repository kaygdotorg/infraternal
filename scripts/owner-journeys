#!/usr/bin/env bash
# Run the owner journeys on compute01 inside a build slot and a private evidence directory.
set -euo pipefail
umask 077
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
if [[ ${1:-} == --help ]]; then
    printf '%s\n' 'Usage: scripts/owner-journeys [--browser-only | --fixture /absolute/path/to/fixture.json]' \
        'Run on compute01 through build-slot. Set OWNER_JOURNEYS_OUT to choose the evidence parent.'
    exit 0
fi
mode=${1:---browser-only}
case "$mode" in
    --browser-only) [[ $# -le 1 ]] ;;
    --fixture) [[ $# == 2 && $2 = /* && -f $2 ]] ;;
    *) exit 2 ;;
esac
out=${OWNER_JOURNEYS_OUT:-$HOME/.cache/codex-scratch/owner-journeys/evidence}
mkdir -p -- "$out"
folder=$(mktemp -d "$out/run.XXXXXX")
printf 'Owner journey evidence: %s\n' "$folder"
# The software authenticator has a persistent signature counter. Keep this suite's runs serial.
exec 9>"$HOME/.cache/codex-scratch/.owner-journeys.lock"
flock 9
unset DEBUG PWDEBUG
exec bun "$root/scripts/owner-journeys.d/run.ts" "$folder" "$mode" "${2:-}"
