#!/usr/bin/env bash
# Prove rootless join and terminal I/O work through the app's public HTTPS listener with port 7443 blackholed [64,168,196,291].
set -euo pipefail
: "${INFRATERNAL_REMOTE_SERVER_TEST_BINARY:?set the compiled server test harness}"
: "${INFRATERNAL_REMOTE_TEST_BINARY:?set the compiled infraternal CLI binary}"
: "${CARGO_TARGET_DIR:?set the job build directory}"

job_root="$(dirname -- "$CARGO_TARGET_DIR")"
# Keep nested session socket paths below Linux's sockaddr_un path limit.
control="$(mktemp -d /tmp/j.XXXXXX)"
chmod 700 "$control"
mkdir -m 700 "$control/runtime"
export INFRATERNAL_TEST_STATE_ROOT="$control/test-state"
export XDG_RUNTIME_DIR="$control/runtime"
export DBUS_SESSION_BUS_ADDRESS="unix:path=$control/no-bus"
export INFRATERNAL_REMOTE_LINK_TRACE=1
export PATH="/sbin:/usr/sbin:$PATH"
fixture_uid="$(id -u)"
fixture_gid="$(id -g)"
trap 'rm -rf -- "$control"' EXIT

unshare --user --map-root-user --net bash -s -- \
    "$fixture_uid" "$fixture_gid" "$INFRATERNAL_REMOTE_SERVER_TEST_BINARY" <<'NAMESPACE'
set -euo pipefail
ip link set lo up
# Run the API's local route after the narrow 7443 blackholes.
ip rule del pref 0
ip rule add pref 10 ipproto tcp dport 7443 blackhole
ip rule add pref 11 ipproto tcp sport 7443 blackhole
ip rule add pref 12 ipproto udp dport 7443 blackhole
ip rule add pref 13 ipproto udp sport 7443 blackhole
ip rule add pref 100 lookup local
sysctl -w net.ipv4.ip_unprivileged_port_start=0 >/dev/null
printf 'namespace_network app_listener=tcp443 blocked_agent_port=tcp_udp7443\n'
unshare --user --map-user="$1" --map-group="$2" \
    "$3" \
    runtime::remote_demo_tests::remote_cli_enrollment_and_browser_terminal_443 \
    --ignored --nocapture --test-threads=1
NAMESPACE
