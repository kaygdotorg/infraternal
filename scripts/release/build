#!/usr/bin/env bash
# Builds both pinned musl payloads with an explicit signed stable/UTC edge identity [20,213,226].
#
# --darwin DIRECTORY adds the macOS arm64 binary that scripts/release/build-darwin
# made on the Mac (#483). The bundle then takes its version from DIRECTORY/VERSION,
# so the Linux and macOS binaries carry one stamped identity, and the Mac binary is
# listed in SHA256SUMS like every other payload. Without it the bundle is
# Linux-only, as before: the Linux release builder cannot link a Mac binary.
#
# Every bundle carries infraternal-web.tar, the web app its images serve
# (scripts/release/web-archive, #211 S6).
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/common"
usage() { printf 'usage: scripts/release/build --channel {stable|edge} [--darwin DIRECTORY]\n' >&2; exit 2; }
[[ ($# == 2 || ($# == 4 && "$3" == --darwin)) && "$1" == --channel ]] || usage
darwin=""
if [[ $# == 4 ]]; then
    darwin="$(cd -- "$4" && pwd)" || { printf 'the macOS build directory is missing\n' >&2; exit 2; }
fi
workspace_version="$release_version"
case "$2" in
    stable) valid_version "$release_version" && [[ "$release_version" != edge-* ]] || { printf 'stable requires workspace x.y.z\n' >&2; exit 2; } ;;
    edge) release_version="edge-$(date -u +%Y%m%dT%H%M%SZ)" ;;
    *) printf 'release channel must be stable or edge\n' >&2; exit 2 ;;
esac
darwin_files=()
if [[ -n "$darwin" ]]; then
    [[ -f "$darwin/VERSION" && -f "$darwin/infraternal-aarch64-darwin" && "$(wc -c < "$darwin/VERSION")" -le 128 ]] ||
        { printf 'the macOS build directory is incomplete\n' >&2; exit 1; }
    release_version="$(head -n 1 "$darwin/VERSION")"
    printf '%s\n' "$release_version" | cmp -s - "$darwin/VERSION" || { printf 'the macOS VERSION file is malformed\n' >&2; exit 1; }
    valid_version "$release_version" || { printf 'the macOS build has an invalid version\n' >&2; exit 1; }
    case "$2" in
        stable) [[ "$release_version" == "$workspace_version" ]] || { printf 'the macOS build is not this stable version\n' >&2; exit 1; } ;;
        edge) [[ "$release_version" == edge-* ]] || { printf 'the macOS build is not an edge build\n' >&2; exit 1; } ;;
    esac
    # A 64-bit arm64 Mach-O (magic cffaedfe, CPU type 0x0100000c, little-endian)
    # that carries the same stamped version string.
    [[ "$(head -c 8 "$darwin/infraternal-aarch64-darwin" | od -An -tx1 | tr -d ' \n')" == cffaedfe0c000001 ]] ||
        { printf 'the macOS binary is not an arm64 Mach-O executable\n' >&2; exit 1; }
    grep -qaF -- "$release_version" "$darwin/infraternal-aarch64-darwin" ||
        { printf 'the macOS binary was not stamped with %s\n' "$release_version" >&2; exit 1; }
    darwin_files=(infraternal-aarch64-darwin)
fi
cd "$release_root"
export CARGO_TARGET_DIR="$release_target"
export INFRATERNAL_RELEASE_BUILD=1
export INFRATERNAL_RELEASE_VERSION="$release_version"
scripts/auth-toolchain
export PATH="$release_target/auth-tools/zig:$PATH"
destination="$release_target/releases/$release_version"
[[ ! -e "$destination" ]] || { printf 'release bundle already exists\n' >&2; exit 1; }
staging="$(mktemp -d "$release_scratch/build.XXXXXX")"
trap 'rm -rf -- "$staging"' EXIT
scripts/package-release "$staging/bundle"
if [[ -n "$darwin" ]]; then
    install -m 755 "$darwin/infraternal-aarch64-darwin" "$staging/bundle/infraternal-aarch64-darwin"
fi
# The web app the release images serve, as one signed payload (#211 S6).
"$release_root/scripts/release/web-archive" "$staging/bundle/infraternal-web.tar"
# Component manifests are root artifacts covered by the release signer's
# SHA256SUMS; their larger archives stay in a content-addressed on-demand tree.
for target in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64; do
    IFS=/ read -r os_name arch <<< "$target"
    python3 "$release_root/scripts/release/traefik_component.py" \
        --release-version "$release_version" --os "$os_name" --arch "$arch" \
        --output "$staging/bundle"
done
printf '%s\n' "$release_version" > "$staging/bundle/VERSION"
(cd "$staging/bundle" && sha256sum VERSION infraternal infraternal-aarch64-musl infraternal-x86_64-musl infraternal-aarch64-session-musl infraternal-x86_64-session-musl infraternal-web.tar ${darwin_files[@]+"${darwin_files[@]}"} proxy-traefik-darwin-amd64.json proxy-traefik-darwin-arm64.json proxy-traefik-linux-amd64.json proxy-traefik-linux-arm64.json "${release_license_files[@]}" > SHA256SUMS)
mkdir -p "$(dirname -- "$destination")"
mv -T -- "$staging/bundle" "$destination"
