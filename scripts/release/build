#!/usr/bin/env bash
# Builds both pinned musl payloads with an explicit signed stable/UTC edge identity [20,213,226].
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/common"
[[ $# == 2 && "$1" == --channel ]] || { printf 'usage: scripts/release/build --channel {stable|edge}\n' >&2; exit 2; }
case "$2" in
    stable) valid_version "$release_version" && [[ "$release_version" != edge-* ]] || { printf 'stable requires workspace x.y.z\n' >&2; exit 2; } ;;
    edge) release_version="edge-$(date -u +%Y%m%dT%H%M%SZ)" ;;
    *) printf 'release channel must be stable or edge\n' >&2; exit 2 ;;
esac
cd "$release_root"
export CARGO_TARGET_DIR="$release_target"
export INFRATERNAL_RELEASE_BUILD=1
export INFRATERNAL_RELEASE_VERSION="$release_version"
scripts/auth-toolchain
export PATH="$release_target/auth-tools/zig:$PATH"
destination="$release_target/releases/$release_version"
[[ ! -e "$destination" ]] || { printf 'release bundle already exists\n' >&2; exit 1; }
staging="$(mktemp -d "$release_scratch/build.XXXXXX")"
trap 'rm -rf -- "$staging"' EXIT
scripts/package-release "$staging/bundle"
# Component manifests are root artifacts covered by the release signer's
# SHA256SUMS; their larger archives stay in a content-addressed on-demand tree.
for target in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64; do
    IFS=/ read -r os_name arch <<< "$target"
    python3 "$release_root/scripts/release/traefik_component.py" \
        --release-version "$release_version" --os "$os_name" --arch "$arch" \
        --output "$staging/bundle"
done
printf '%s\n' "$release_version" > "$staging/bundle/VERSION"
(cd "$staging/bundle" && sha256sum VERSION infraternal infraternal-aarch64-musl infraternal-x86_64-musl infraternal-aarch64-session-musl infraternal-x86_64-session-musl proxy-traefik-darwin-amd64.json proxy-traefik-darwin-arm64.json proxy-traefik-linux-amd64.json proxy-traefik-linux-arm64.json "${release_license_files[@]}" > SHA256SUMS)
mkdir -p "$(dirname -- "$destination")"
mv -T -- "$staging/bundle" "$destination"
