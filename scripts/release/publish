#!/usr/bin/env bash
# Uploads an immutable bundle, requests Worker signing, then verifies public bytes [184,224].
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/common"
[[ $# == 1 ]] || { printf 'usage: scripts/release/publish VERSION\n' >&2; exit 2; }
publication_version "$1"
: "${CLOUDFLARE_API_TOKEN:?set CLOUDFLARE_API_TOKEN in the environment}"
: "${RELEASE_CALLER_TOKEN:?set RELEASE_CALLER_TOKEN in the environment}"
: "${CLOUDFLARE_ACCOUNT_ID:?set CLOUDFLARE_ACCOUNT_ID in the environment}"
[[ "$CLOUDFLARE_ACCOUNT_ID" =~ ^[a-zA-Z0-9]+$ ]] || { printf 'invalid account identifier\n' >&2; exit 2; }
bundle="$release_target/releases/$1"
files=(VERSION infraternal infraternal-x86_64-musl infraternal-aarch64-musl infraternal-x86_64-session-musl infraternal-aarch64-session-musl proxy-traefik-darwin-amd64.json proxy-traefik-darwin-arm64.json proxy-traefik-linux-amd64.json proxy-traefik-linux-arm64.json "${release_license_files[@]}")
component_archives=(components/$1/proxy/darwin/amd64/traefik_v3.7.17_darwin_amd64.tar.gz components/$1/proxy/darwin/arm64/traefik_v3.7.17_darwin_arm64.tar.gz components/$1/proxy/linux/amd64/traefik_v3.7.17_linux_amd64.tar.gz components/$1/proxy/linux/arm64/traefik_v3.7.17_linux_arm64.tar.gz)
for name in "${files[@]}" "${component_archives[@]}"; do [[ -f "$bundle/$name" ]] || { printf 'build the release bundle first\n' >&2; exit 1; }; done
printf '%s\n' "$1" | cmp - "$bundle/VERSION" || { printf 'the built bundle belongs to another version\n' >&2; exit 1; }
api="$release_api/accounts/$CLOUDFLARE_ACCOUNT_ID/r2/buckets/infraternal-builds/objects/releases/$1"
# All build directories for this user share one inode. Never unlink the lock:
# replacing it could admit a new writer while an older process still holds it.
umask 077
lock_directory="${XDG_STATE_HOME:-$HOME/.local/state}/infraternal/release-publish"
[[ "$lock_directory" == /* ]] || { printf 'the publication state directory must be absolute\n' >&2; exit 1; }
mkdir -p -- "$lock_directory"
[[ -d "$lock_directory" && ! -L "$lock_directory" && -O "$lock_directory" && "$(stat -c '%a' "$lock_directory")" == 700 ]] || { printf 'the publication lock directory is unsafe\n' >&2; exit 1; }
lock="$lock_directory/$1.lock"
[[ ! -e "$lock" && ! -L "$lock" ]] || [[ -f "$lock" && ! -L "$lock" && -O "$lock" && "$(stat -c '%h:%a' "$lock")" == 1:600 ]] || { printf 'the publication lock file is unsafe\n' >&2; exit 1; }
exec 9>> "$lock"
flock -n 9 || { printf 'a publisher for this version is already running\n' >&2; exit 1; }
staging=""
trap '[[ -z "$staging" ]] || rm -rf -- "$staging"' EXIT
staging="$(mktemp -d "$release_scratch/publish.XXXXXX")"
# Query the authoritative API prefix, including unrelated or partial objects.
# A provider error or ambiguous response never becomes permission to overwrite.
request "$CLOUDFLARE_API_TOKEN" --get --data-urlencode "prefix=releases/$1/" --data-urlencode 'per_page=1' \
    "${api%/releases/$1}" | python3 "$release_root/scripts/release/response.py" empty-prefix
for name in "${files[@]}"; do
    request "$CLOUDFLARE_API_TOKEN" --request PUT --header 'If-None-Match: *' \
        --header 'Content-Type: application/octet-stream' --data-binary "@$bundle/$name" "$api/$name" | \
        python3 "$release_root/scripts/release/response.py" uploaded
done
for name in "${component_archives[@]}"; do
    request "$CLOUDFLARE_API_TOKEN" --request PUT --header 'If-None-Match: *' \
        --header 'Content-Type: application/octet-stream' --data-binary "@$bundle/$name" "$api/$name" | \
        python3 "$release_root/scripts/release/response.py" uploaded
done
request "$RELEASE_CALLER_TOKEN" --request POST --header 'Content-Type: application/json' \
    --data "{\"version\":\"$1\"}" "$release_signer/sign" | python3 "$release_root/scripts/release/response.py" signed
verify_download "$1" "$staging"
for name in "${files[@]}"; do
    cmp -- "$bundle/$name" "$staging/$name" || { printf 'published bytes differ from the built bundle\n' >&2; exit 1; }
done
printf 'Published and verified infraternal %s.\n' "$1"
