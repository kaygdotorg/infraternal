#!/usr/bin/env bash
# Build MIT-licensed libghostty-vt with a read-only snapshot adapter [7,20,94].
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
output="${1:?Cargo OUT_DIR required}"
version=a887df42c56f6de86c0fe6da9c4eeca37931e083
checksum=fb4b2f9ffa0af125983041fdbe4ef94d3fa79fb9f2d22b9c213c0e3847a866b6
target_root="${CARGO_TARGET_DIR:-$root/target}"
[[ "$target_root" = /* ]] || target_root="$root/$target_root"
"$root/scripts/auth-toolchain"
zig="$target_root/auth-tools/zig/zig"
[[ "$("$zig" version)" == 0.15.2 ]] || { printf 'libghostty-vt requires Zig 0.15.2\n' >&2; exit 1; }
case "${TARGET:?Cargo target required}" in
    x86_64-unknown-linux-musl) vt_target=x86_64-linux-musl ;;
    aarch64-unknown-linux-musl) vt_target=aarch64-linux-musl ;;
    x86_64-unknown-linux-gnu) vt_target=x86_64-linux-gnu ;;
    aarch64-unknown-linux-gnu) vt_target=aarch64-linux-gnu ;;
    *) printf 'unsupported libghostty-vt target: %s\n' "$TARGET" >&2; exit 1 ;;
esac
vt_tools="$target_root/vt-tools"
mkdir -p "$vt_tools"
archive="$vt_tools/$version.tar.gz"
if [[ ! -f "$archive" ]]; then
    temporary="$(mktemp "$vt_tools/download.XXXXXX")"
    trap 'rm -f -- "$temporary"' EXIT
    curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location \
        "https://codeload.github.com/ghostty-org/ghostty/tar.gz/$version" -o "$temporary"
    printf '%s  %s\n' "$checksum" "$temporary" | sha256sum --check --status
    mv "$temporary" "$archive"
fi
printf '%s  %s\n' "$checksum" "$archive" | sha256sum --check --status
# Cargo check/test/features have different OUT_DIRs. Key the expensive native
# build by source, adapter, build recipe, ABI and optimization instead. A lock
# prevents two Cargo invocations from observing a partly installed archive.
optimize=ReleaseSafe
[[ "${PROFILE:-debug}" != release ]] || optimize=ReleaseFast
session_image="${CARGO_FEATURE_SESSION_IMAGE:-0}"
key="$( { sha256sum "$root/crates/infraternal-shim/native/snapshot.zig" "$root/crates/infraternal-shim/native/session_log.zig" "$root/scripts/build-vt"; printf '%s %s %s %s\n' "$checksum" "$vt_target" "$optimize" "$session_image"; } | sha256sum | cut -d ' ' -f1)"
cache_dir="$vt_tools/native-$key"
mkdir -p "$cache_dir"
exec 9> "$cache_dir/lock"
flock 9
if [[ -f "$cache_dir/native/lib/libghostty-vt.a" ]]; then
    rm -rf -- "$output/native"
    ln -s "$cache_dir/native" "$output/native"
    exit 0
fi
source_dir="$cache_dir/ghostty-source"
if [[ ! -d "$source_dir" ]]; then
    mkdir -p "$source_dir"
    tar -xzf "$archive" --strip-components=1 -C "$source_dir"
fi
cp "$root/crates/infraternal-shim/native/snapshot.zig" "$source_dir/src/infraternal_snapshot.zig"
# Restore the exact upstream root before adding our three adapter exports.
tar -xOf "$archive" "ghostty-$version/src/lib_vt.zig" > "$source_dir/src/lib_vt.zig"
if [[ "$session_image" == 1 ]]; then
    # The private executable uses only the callback-free Rust adapter. Do not
    # expose setters that would appear to accept a callback while dropping it.
    # Ordinary archives retain every upstream export and callback semantics.
    cp "$root/crates/infraternal-shim/native/session_log.zig" "$source_dir/src/infraternal_session_log.zig"
    sed -i '/\.name = "ghostty_sys_set"/d; /\.name = "ghostty_sys_log_stderr"/d; s|@import("terminal/c/sys.zig").logFn|@import("infraternal_session_log.zig").logFn|' "$source_dir/src/lib_vt.zig"
fi
cat >> "$source_dir/src/lib_vt.zig" <<'ZIG'

comptime {
    @export(&@import("infraternal_snapshot.zig").approximate, .{ .name = "infraternal_vt_approximate" });
    @export(&@import("infraternal_snapshot.zig").snapshot, .{ .name = "infraternal_vt_snapshot" });
    @export(&@import("infraternal_snapshot.zig").compare, .{ .name = "infraternal_vt_compare" });
}
ZIG
# Keep every upstream API in the archive, but let the final static link discard
# APIs the shim never calls. One monolithic section otherwise retains input
# encoders, formatters and render-state helpers with the terminal engine [243].
# Restore the pinned build definition before adjusting its section layout, so
# retries cannot accumulate edits in the native source cache.
build_definition=src/build/GhosttyLibVt.zig
tar -xOf "$archive" "ghostty-$version/$build_definition" > "$source_dir/$build_definition"
sed -i '/lib.bundle_compiler_rt = true;/a\
        lib.link_function_sections = true;\
        lib.link_data_sections = true;' "$source_dir/$build_definition"
# The final release executable is already stripped. Tell native compilation
# the same fact, avoiding its source-symbol reader in that distribution. Native
# panic messages remain, but raw stack-address/external-symbol fallback is lost.
# Keep development diagnostics, frame-pointer and unwind settings unchanged [5,243].
if [[ "$optimize" == ReleaseFast ]]; then
    sed -i '/lib.bundle_compiler_rt = true;/a\
        lib.root_module.strip = true;' "$source_dir/$build_definition"
fi
# Baseline CPU keeps distributed binaries valid on hosts older than the builder.
# ReleaseSafe retains bounds checks in development; release uses ReleaseFast.
cd "$source_dir"
"$zig" build -j2 -Demit-lib-vt=true -Doptimize="$optimize" -Dcpu=baseline \
    -Dtarget="$vt_target" -Demit-xcframework=false -Dapp-runtime=none \
    --prefix "$cache_dir/native" --cache-dir "$cache_dir/zig-cache" \
    --global-cache-dir "$vt_tools/zig-cache"
rm -rf -- "$output/native"
ln -s "$cache_dir/native" "$output/native"
