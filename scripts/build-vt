#!/usr/bin/env bash
# Build the signed libghostty-vt release and our bounded state adapter [7,20,94].
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
output="${1:?Cargo OUT_DIR required}"
version=1.0.0
target_root="${CARGO_TARGET_DIR:-$root/target}"
[[ "$target_root" = /* ]] || target_root="$root/$target_root"
"$root/scripts/auth-toolchain"
zig="$target_root/auth-tools/zig/zig"
[[ "$("$zig" version)" == 0.17.0 ]] || { printf 'libghostty-vt 1.0.0 requires Zig 0.17.0\n' >&2; exit 1; }
case "${TARGET:?Cargo target required}" in
    x86_64-unknown-linux-musl) vt_target=x86_64-linux-musl ;;
    aarch64-unknown-linux-musl) vt_target=aarch64-linux-musl ;;
    x86_64-unknown-linux-gnu) vt_target=x86_64-linux-gnu ;;
    aarch64-unknown-linux-gnu) vt_target=aarch64-linux-gnu ;;
    # The shim links the same static engine on macOS without SDK frameworks.
    aarch64-apple-darwin) vt_target=aarch64-macos ;;
    *) printf 'unsupported libghostty-vt target: %s\n' "$TARGET" >&2; exit 1 ;;
esac

vt_tools="$target_root/vt-tools"
mkdir -p "$vt_tools"
source_name="libghostty-vt-$version.tar.gz"
deps_name="libghostty-vt-$version-deps.tar.gz"
source_archive="$vt_tools/$source_name"
source_signature="$source_archive.minisig"
deps_archive="$vt_tools/$deps_name"
deps_signature="$deps_archive.minisig"
release_url="https://release.files.ghostty.org/libghostty-vt/$version"
minisign_public_key=RWQlAjJC23149WL2sEpT/l0QKy7hMIFhYdQOFy0Z7z7PbneUgvlsnYcV

# Both archives and both signatures are hash-pinned, then signature-verified
# before extraction. Nix supplies these files in its offline build sandbox.
sha256_check() {
    local checksum="$1"
    local file="$2"
    if command -v sha256sum > /dev/null; then
        printf '%s  %s\n' "$checksum" "$file" | sha256sum --check --status
    else
        printf '%s  %s\n' "$checksum" "$file" | shasum -a 256 --check --status
    fi
}
fetch_pinned() {
    local name="$1"
    local destination="$2"
    local checksum
    checksum="$(awk -v file="$name" '$2 == file { print $1 }' "$root/scripts/libghostty-vt.sha256")"
    [[ -n "$checksum" ]] || { printf 'no pinned checksum for %s\n' "$name" >&2; return 1; }
    if [[ ! -f "$destination" ]]; then
        local temporary
        temporary="$(mktemp "$vt_tools/download.XXXXXX")"
        if ! curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location \
            "$release_url/$name" -o "$temporary"; then
            rm -f -- "$temporary"
            return 1
        fi
        if ! sha256_check "$checksum" "$temporary"; then
            rm -f -- "$temporary"
            return 1
        fi
        mv "$temporary" "$destination"
    fi
    sha256_check "$checksum" "$destination"
}
for asset in "$source_name" "$source_name.minisig" "$deps_name" "$deps_name.minisig"; do
    case "$asset" in
        "$source_name") destination="$source_archive" ;;
        "$source_name.minisig") destination="$source_signature" ;;
        "$deps_name") destination="$deps_archive" ;;
        "$deps_name.minisig") destination="$deps_signature" ;;
    esac
    fetch_pinned "$asset" "$destination"
done
command -v minisign > /dev/null || { printf 'minisign is required to verify libghostty-vt releases\n' >&2; exit 1; }
minisign -V -P "$minisign_public_key" -m "$source_archive" -x "$source_signature"
minisign -V -P "$minisign_public_key" -m "$deps_archive" -x "$deps_signature"

# Cargo features define separate, reproducible native archives. Input encoding
# is present only for the explicit native mouse probe; shipping builds retain
# the parser and the adapter while compiling every optional VT API feature out.
optimize=ReleaseSafe
[[ "${PROFILE:-debug}" != release ]] || optimize=ReleaseFast
shared_host="${CARGO_FEATURE_PROCESS_PER_USER:-}"
compact_history="${CARGO_FEATURE_COMPACT_HISTORY:-}"
session_image="${CARGO_FEATURE_SESSION_IMAGE:-}"
test_input="${CARGO_FEATURE_VT_TEST_INPUT:-}"
vt_features=-all
[[ -z "$test_input" ]] || vt_features=-all,+input-encode
strip=false
[[ "$optimize" != ReleaseFast ]] || strip=true

# Include every input that can alter native output so Cargo profiles and
# feature combinations never race to install a different archive in one cache.
key="$( {
    sha256sum "$root/crates/infraternal-shim/native/snapshot.zig" \
        "$root/scripts/build-vt" "$root/scripts/patch-libghostty-vt.py"
    if [[ -n "$shared_host" ]]; then
        sha256sum "$root/crates/infraternal-shim/native/memory.zig"
    fi
    if [[ -n "$compact_history" ]]; then
        sha256sum "$root/crates/infraternal-shim/native/history.zig"
    fi
    if [[ -n "$session_image" ]]; then
        sha256sum "$root/crates/infraternal-shim/native/session_log.zig"
    fi
    printf '%s %s %s %s %s %s %s %s %s\n' \
        "$(awk -v file="$source_name" '$2 == file { print $1 }' "$root/scripts/libghostty-vt.sha256")" \
        "$(awk -v file="$deps_name" '$2 == file { print $1 }' "$root/scripts/libghostty-vt.sha256")" \
        "$vt_target" "$optimize" "$strip" "$vt_features" "$shared_host" "$compact_history" "$session_image"
} | sha256sum | cut -d ' ' -f1)"
cache_dir="$vt_tools/native-$key"
mkdir -p "$cache_dir"
exec 9> "$cache_dir/lock"
if command -v flock > /dev/null; then
    flock 9
else
    # macOS has flock(2) but not flock(1). This descriptor keeps the lock after
    # the short-lived Perl locker exits.
    perl -MFcntl=:flock -e 'open(my $f, ">&=", 9) or die "fd 9: $!"; flock($f, LOCK_EX) or die "flock: $!"'
fi
wire_static_link_dir() {
    # Keep the pkg-config library directory intact while giving Cargo a path
    # that cannot resolve libghostty-vt.dylib instead of our adapter archive.
    local native_root="$1"
    local link_dir="$native_root/static-link"
    [[ -f "$native_root/lib/libghostty-vt.a" ]] || {
        printf 'missing static libghostty-vt archive under %s\n' "$native_root" >&2
        return 1
    }
    rm -rf -- "$link_dir"
    mkdir -p "$link_dir"
    ln -s ../lib/libghostty-vt.a "$link_dir/libghostty-vt.a"
}
if [[ -f "$cache_dir/native/lib/libghostty-vt.a" ]]; then
    wire_static_link_dir "$cache_dir/native"
    rm -rf -- "$output/native"
    ln -s "$cache_dir/native" "$output/native"
    exit 0
fi

source_dir="$cache_dir/libghostty-vt-$version"
deps_dir="$cache_dir/libghostty-vt-$version-deps"
rm -rf -- "$source_dir" "$deps_dir" "$cache_dir/native"
mkdir -p "$source_dir" "$deps_dir"
tar -xzf "$source_archive" --strip-components=1 -C "$source_dir"
tar -xzf "$deps_archive" --strip-components=1 -C "$deps_dir"
cp "$root/crates/infraternal-shim/native/snapshot.zig" "$source_dir/src/infraternal_snapshot.zig"
cat >> "$source_dir/src/lib_vt.zig" <<'ZIG_SNAPSHOT'

comptime {
    @export(&@import("infraternal_snapshot.zig").approximate, .{ .name = "infraternal_vt_approximate" });
    @export(&@import("infraternal_snapshot.zig").snapshot, .{ .name = "infraternal_vt_snapshot" });
    @export(&@import("infraternal_snapshot.zig").compare, .{ .name = "infraternal_vt_compare" });
}
ZIG_SNAPSHOT
if [[ -n "$shared_host" ]]; then
    cp "$root/crates/infraternal-shim/native/memory.zig" "$source_dir/src/infraternal_memory.zig"
    cat >> "$source_dir/src/lib_vt.zig" <<'ZIG_SCREEN'

comptime {
    @export(&@import("infraternal_memory.zig").screenPages, .{ .name = "infraternal_vt_screen_pages" });
}
ZIG_SCREEN
fi
if [[ -n "$compact_history" ]]; then
    cp "$root/crates/infraternal-shim/native/history.zig" "$source_dir/src/infraternal_history.zig"
    # The optional experiment needs an internal PageList compression step;
    # the stable C API exposes neither cold pages nor a compact-history call.
    cat >> "$source_dir/src/lib_vt.zig" <<'ZIG_HISTORY'

comptime {
    @export(&@import("infraternal_history.zig").compact, .{ .name = "infraternal_vt_compact" });
}
ZIG_HISTORY
fi
if [[ -n "$session_image" ]]; then
    cp "$root/crates/infraternal-shim/native/session_log.zig" "$source_dir/src/infraternal_session_log.zig"
fi
python3 "$root/scripts/patch-libghostty-vt.py" "$source_dir" "$shared_host" "$compact_history" "$session_image"

# The release graph gates benchmark artifacts upstream, but its static library
# has no per-function/data sections for final-link garbage collection. Restore
# those sections for every build. Private session images have no C log callback
# consumer, so the patcher also uses a no-op sink for those images only.
# --system plus a fresh global cache keeps the Zig package build offline and
# proves it used only the signed dependency tarball.
global_cache="$cache_dir/zig-global-cache"
rm -rf -- "$global_cache"
mkdir -p "$global_cache"
cd "$source_dir"
build_args=(
    build -j2
    -Demit-lib-vt=true
    -Demit-xcframework=false
    -Doptimize="$optimize"
    -Dcpu=baseline
    -Dtarget="$vt_target"
    -Dvt-features="$vt_features"
    -Dstrip="$strip"
    --system "$deps_dir"
    --prefix "$cache_dir/native"
    --cache-dir "$cache_dir/zig-cache"
)
# Zig 0.17 reads the global cache location from the environment.
ZIG_GLOBAL_CACHE_DIR="$global_cache" "$zig" "${build_args[@]}"
wire_static_link_dir "$cache_dir/native"

# The cache retains both release library forms; build.rs explicitly asks Cargo
# to link the static archive used by the shim.
rm -rf -- "$output/native"
ln -s "$cache_dir/native" "$output/native"
