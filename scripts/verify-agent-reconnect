#!/usr/bin/env bash
# Run the release-transition process proof in an owned network namespace [128,168,215], #225.
set -euo pipefail
: "${INFRATERNAL_RECONNECT_TEST_BINARY:?set the prebuilt test harness matching the oldest server schema}"
: "${INFRATERNAL_OLD_TEST_BINARY:?set the enrolled infraternal agent binary}"
: "${INFRATERNAL_REMOTE_TEST_BINARY:?set the replacement server binary}"
: "${CARGO_TARGET_DIR:?set the job build directory}"
# Default to the field-shaped TCP regression; zero values retain control cases.
export INFRATERNAL_RECONNECT_STALL_SECONDS="${INFRATERNAL_RECONNECT_STALL_SECONDS:-600}"
export INFRATERNAL_RECONNECT_BLACKHOLE="${INFRATERNAL_RECONNECT_BLACKHOLE:-1}"
export INFRATERNAL_RECONNECT_TCP_ONLY="${INFRATERNAL_RECONNECT_TCP_ONLY:-1}"
job_root="$(dirname -- "$CARGO_TARGET_DIR")"
control="$(mktemp -d "$job_root/reconnect.XXXXXX")"
chmod 700 "$control"
mkdir -m 700 "$control/runtime"
export INFRATERNAL_RECONNECT_CONTROL="$control"
export XDG_RUNTIME_DIR="$control/runtime"
# Keep shim socket names within Linux sun_path while retaining job ownership.
export INFRATERNAL_TEST_STATE_ROOT="$job_root/t"
# Never let fixture shims or session-manager detection reach the owner's bus.
export DBUS_SESSION_BUS_ADDRESS="unix:path=$control/no-bus"
fixture_uid="${INFRATERNAL_RECONNECT_UID:-$(id -u)}"
fixture_gid="${INFRATERNAL_RECONNECT_GID:-$(id -g)}"
trap 'rm -rf -- "$control"' EXIT
unshare --user --map-root-user --net bash -s -- "$fixture_uid" "$fixture_gid" <<'NAMESPACE'
set -euo pipefail
ip link set lo up
# Put fixture routing rules before local delivery, including cached TCP routes.
ip rule del pref 0
ip rule add pref 100 lookup local
if [[ "${INFRATERNAL_RECONNECT_TCP_ONLY:-0}" == 1 ]]; then
    # Protocol routing drops only UDP inside this namespace, proving the real
    # TCP fallback rather than assuming which dial race won.
    ip rule add pref 50 ipproto udp blackhole
    printf 'namespace_network tcp_only=true\n'
fi
# The outer namespace owns network administration. The test and every daemon
# retain the caller's rootless uid in a nested user namespace.
unshare --user --map-user="$1" --map-group="$2" \
    "$INFRATERNAL_RECONNECT_TEST_BINARY" \
    --exact runtime::remote_demo_tests::cold_start::release_transition_recovers_enrolled_host_after_long_outage \
    --ignored --nocapture &
test_pid=$!
wait_phase() {
    local phase="$1"
    while [[ ! -f "$INFRATERNAL_RECONNECT_CONTROL/$phase" ]]; do
        if ! kill -0 "$test_pid" 2>/dev/null; then
            wait "$test_pid"
            return 1
        fi
        sleep 0.1
    done
}
wait_phase disconnect
if [[ "${INFRATERNAL_RECONNECT_BLACKHOLE:-0}" == 1 ]]; then
    # Discard the old server's close as well as client data. Merely lowering lo
    # can still deliver a local TCP close and accidentally model an orderly stop.
    ip rule add pref 10 ipproto tcp dport 7443 blackhole
    ip rule add pref 11 ipproto tcp sport 7443 blackhole
    ip rule add pref 12 ipproto udp dport 7443 blackhole
    ip rule add pref 13 ipproto udp sport 7443 blackhole
else
    ip link set lo down
fi
: > "$INFRATERNAL_RECONNECT_CONTROL/disconnect-done"
printf 'namespace_network unreachable=true\n'
wait_phase restore
if [[ "${INFRATERNAL_RECONNECT_BLACKHOLE:-0}" == 1 ]]; then
    ss -Htn state established '( sport = :7443 or dport = :7443 )'
    for preference in 10 11 12 13; do ip rule del pref "$preference"; done
else
    ip link set lo up
fi
: > "$INFRATERNAL_RECONNECT_CONTROL/restore-done"
printf 'namespace_network restored=true\n'
wait "$test_pid"
NAMESPACE
