#!/usr/bin/env bash
# Dispatch repository verification modes and report which gate is not ready yet.
set -euo pipefail

# Ghostty VT and vendored C share the one checksum-pinned Zig [94][213].
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
target_dir="${CARGO_TARGET_DIR:-$repo_root/target}"
[[ "$target_dir" = /* ]] || target_dir="$repo_root/$target_dir"
# Exported so unit tests that place private fixtures under the target folder
# (release staging tests) find it whether or not the caller set it.
export CARGO_TARGET_DIR="$target_dir"
"$repo_root/scripts/auth-toolchain"
export PATH="$target_dir/auth-tools/zig:$PATH"

# Nix hosts may expose Rust but omit OpenSSL's native build drivers. CI installs
# these explicitly; the documented Nix invocation supplies them here when absent.
if ! command -v make >/dev/null || ! command -v perl >/dev/null; then
    if command -v nix >/dev/null; then
        exec nix shell nixpkgs#gnumake nixpkgs#perl -c "$0" "$@"
    fi
    printf 'verify requires make and perl for vendored OpenSSL
' >&2
    exit 1
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "${script_dir}/verify.d/rust.sh"
source "${script_dir}/verify.d/ts.sh"
source "${script_dir}/verify.d/quick.sh"

verify_latency() {
    local repo_dir="$(cd -- "${script_dir}/.." && pwd)"
    local target_dir="${CARGO_TARGET_DIR:-$repo_dir/target}"
    local failed=0
    export CARGO_TARGET_DIR="$target_dir"
    export TRACER_TEST_PORT="${TRACER_TEST_PORT:-4621}"
    mkdir -p "$CARGO_TARGET_DIR"

    report_environment() {
        local rtt="${INFRATERNAL_TEST_RTT:-300}"
        local jitter=30
        [[ "$rtt" == 0 ]] && jitter=0
        printf 'ENVIRONMENT phase=%s machine=%s arch=%s cores=%s load=%s tracer_test_port=%s rtt_ms=%s jitter_ms=%s\n' \
            "$1" "$(uname -n)" "$(uname -m)" "$(getconf _NPROCESSORS_ONLN)" "$(cut -d' ' -f1-3 /proc/loadavg)" \
            "$TRACER_TEST_PORT" "$rtt" "$jitter"
    }

    report_environment setup

    python3 "${script_dir}/latency_proxy.py" self-test --samples 31 || failed=1
    if scripts/static-cargo build --locked --release --package infraternal --target x86_64-unknown-linux-musl; then
        report_environment native
        python3 "${script_dir}/verify-latency.py" \
            --binary "$CARGO_TARGET_DIR/x86_64-unknown-linux-musl/release/infraternal" || failed=1
    else
        failed=1
    fi

    report_environment auth-browser
    "${script_dir}/verify-auth-browser" || failed=1
    # `set -e` does not apply inside a subshell on the left of `||`, so the steps are
    # chained: a failed install or typecheck must fail the row, not only the browser run.
    (
        cd -- "$repo_dir/apps/tracer" &&
            bun install --frozen-lockfile &&
            bun run check &&
            report_environment tracer-browser &&
            TRACER_TEST_PORT="$TRACER_TEST_PORT" bun x playwright test
    ) || failed=1
    report_environment finish
    return "$failed"
}

# Browser specs against the real server binary and a production build of the tracer (no test double): the canvas
# on real sessions (apps/tracer/real). INFRATERNAL_BIN overrides the binary that is built here.
verify_integration() {
    local repo_dir="$(cd -- "${script_dir}/.." && pwd)"
    local target_dir="${CARGO_TARGET_DIR:-$repo_dir/target}"
    export CARGO_TARGET_DIR="$target_dir"
    if [[ -z "${INFRATERNAL_BIN:-}" ]]; then
        scripts/static-cargo build --locked --release --package infraternal --target x86_64-unknown-linux-musl || return 1
        export INFRATERNAL_BIN="$CARGO_TARGET_DIR/x86_64-unknown-linux-musl/release/infraternal"
    fi
    # Chained for the same reason as verify_latency: the caller may test this function's
    # status, which turns `set -e` off inside it.
    (
        cd -- "$repo_dir/apps/tracer" &&
            bun install --frozen-lockfile &&
            bun run check &&
            bun run build &&
            bun x playwright test -c playwright.real.config.ts
    )
}

if [[ $# -ne 1 ]]; then
    printf 'usage: scripts/verify {quick|fast|iterate|nightly|integration|browser|latency|bench}\n' >&2
    exit 2
fi

case "$1" in
    quick)
        # Pre-check before the gate (#329): never a substitute for "fast".
        verify_quick
        ;;
    fast|iterate)
        # "fast" is the full final gate. "iterate" is the cheaper loop for use
        # between commits: identical checks minus the two static release
        # builds, linkage, key-heap and size checks (see rust_verify_fast).
        # Run "fast" before reporting work done.
        mode=final
        [[ "$1" == iterate ]] && mode=iterate
        printf '\n==> Repository artifact size gate\n'
        python3 "${script_dir}/verify.d/evidence-size.py"
        printf '\n==> Release deployment functional checks\n'
        python3 "${script_dir}/release/deploy_test.py"
        python3 "${script_dir}/release/staging_artifacts_test.py"
        bun test "${script_dir}/release/deploy-review.test.ts"
        python3 "${script_dir}/latency_proxy.py" self-test --samples 3 --forwarding-only
        rust_verify_fast "$mode"
        ts_verify_fast
        if [[ "$mode" == iterate ]]; then
            printf '\nITERATE gate passed. This is not the final gate: run scripts/verify fast before reporting done.\n'
        fi
        ;;
    nightly)
        # The ordinary workspace gate already runs the 1k smoke corpus.
        # Nightly uses optimized Rust/native code for all 20k deterministic
        # cases, with safe console output even when an assertion fails.
        vt_nightly_corpus() {
            # Fresh C and RIS differ in prompt-redraw state in the pinned API.
            # Report both contexts; never hide that difference by normalization.
            for initial in RIS fresh-c; do
                VT_SNAPSHOT_INITIAL="$initial" cargo test --release --locked -p infraternal-shim --lib fidelity_seeded_nightly \
                    -- --ignored --nocapture --test-threads=1 2>&1 | tr -c '[:print:]\n' '.' || return $?
            done
            VT_SNAPSHOT_INITIAL=RIS cargo test --release --locked -p infraternal-shim --lib fidelity_extended_nightly \
                -- --ignored --nocapture --test-threads=1 2>&1 | tr -c '[:print:]\n' '.'
        }
        rust_run_gate "VT nightly corpus" vt_nightly_corpus
        rust_print_summary
        exit "$RUST_GATE_FAILED"
        ;;
    browser)
        "${script_dir}/verify-auth-browser"
        ;;
    latency)
        verify_latency
        ;;
    integration)
        verify_integration
        ;;
    bench)
        printf '%s: not yet implemented\n' "$1"
        ;;
    *)
        printf 'unknown verification mode: %s\n' "$1" >&2
        printf 'usage: scripts/verify {fast|iterate|nightly|integration|browser|latency|bench}\n' >&2
        exit 2
        ;;
esac
