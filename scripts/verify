#!/usr/bin/env bash
# Dispatch repository verification modes and report which gate is not ready yet.
set -euo pipefail

# Ghostty VT and vendored C share the one checksum-pinned Zig [94][213].
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
target_dir="${CARGO_TARGET_DIR:-$repo_root/target}"
[[ "$target_dir" = /* ]] || target_dir="$repo_root/$target_dir"
# Exported so unit tests that place private fixtures under the target folder
# (release staging tests) find it whether or not the caller set it.
export CARGO_TARGET_DIR="$target_dir"
# A gate builds each crate once, so incremental caches never get reused but cost about a fifth of
# the target (12 of 56 GB, #574). Callers that iterate on one checkout may still set it to 1.
export CARGO_INCREMENTAL="${CARGO_INCREMENTAL:-0}"

# Cargo does not make a target directory safe to share between source roots.
# Remember the last checkout and revision so a comparison with reused artifacts
# is visible before the verifier starts building or reading from that target.
source_revision="unavailable"
if ! source_revision="$(git -C "$repo_root" rev-parse HEAD 2>/dev/null)"; then
    source_revision="unavailable"
fi
source_identity="$(printf '%s\n%s' "$repo_root" "$source_revision")"
source_marker="$target_dir/.infraternal-source-identity"
mkdir -p "$target_dir"
if [[ -f "$source_marker" ]]; then
    previous_identity="$(cat -- "$source_marker")"
    if [[ "$previous_identity" != "$source_identity" ]]; then
        previous_root="$(sed -n '1p' "$source_marker")"
        previous_revision="$(sed -n '2p' "$source_marker")"
        printf 'WARNING: CARGO_TARGET_DIR %s was last used by %s at %s; current source is %s at %s. Use a separate target for each source worktree/revision (#542).\n' \
            "$target_dir" "${previous_root:-unknown}" "${previous_revision:-unknown}" \
            "$repo_root" "$source_revision" >&2
    fi
fi
source_marker_tmp="${source_marker}.tmp.$$"
printf '%s\n%s\n' "$repo_root" "$source_revision" > "$source_marker_tmp"
mv -f -- "$source_marker_tmp" "$source_marker"

# The latency profile can measure a binary built elsewhere (INFRATERNAL_LATENCY_BINARY, #447):
# the perf VM never builds, so it has no Zig, no cargo and no OpenSSL build drivers to prepare.
prebuilt_latency=0
if [[ "${1:-}" == latency && -n "${INFRATERNAL_LATENCY_BINARY:-}" ]]; then
    prebuilt_latency=1
fi

if [[ "$prebuilt_latency" == 0 ]]; then
    "$repo_root/scripts/auth-toolchain"
    export PATH="$target_dir/auth-tools/zig:$PATH"

    # Nix hosts may expose Rust but omit OpenSSL's native build drivers. CI installs
    # these explicitly; the documented Nix invocation supplies them here when absent.
    if ! command -v make >/dev/null || ! command -v perl >/dev/null; then
        if command -v nix >/dev/null; then
            exec nix shell nixpkgs#gnumake nixpkgs#perl -c "$0" "$@"
        fi
        printf 'verify requires make and perl for vendored OpenSSL\n' >&2
        exit 1
    fi
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "${script_dir}/verify.d/rust.sh"
source "${script_dir}/verify.d/ts.sh"
source "${script_dir}/verify.d/quick.sh"

# The latency profile (D375): runs every producer of a D375 row, keeps the whole
# output as evidence outside the checkout, and ends with the ten-row table. The
# run fails when any step fails or when a row is missing or misses its gate.
verify_latency() {
    local evidence_dir
    evidence_dir="$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import evidence_path; print(evidence_path.evidence_directory("latency"))' "$script_dir")"
    mkdir -p "$evidence_dir"
    local log="$evidence_dir/verify-latency-$(date -u +%Y%m%dT%H%M%SZ).log"
    local status
    # Every row producer reads this to take full samples (and the browser-only rows run at all).
    export INFRATERNAL_LATENCY_PROFILE=1
    set +e
    verify_latency_steps 2>&1 | tee "$log"
    status="${PIPESTATUS[0]}"
    set -e
    python3 "${script_dir}/latency_targets.py" report "$log" || status=1
    printf 'latency profile log: %s\n' "$log"
    return "$status"
}

# The measuring steps of the latency profile; verify_latency records and reports them.
verify_latency_steps() {
    local repo_dir="$(cd -- "${script_dir}/.." && pwd)"
    local target_dir="${CARGO_TARGET_DIR:-$repo_dir/target}"
    local failed=0
    export CARGO_TARGET_DIR="$target_dir"
    export TRACER_TEST_PORT="${TRACER_TEST_PORT:-4621}"
    # Production (ssh.kayg.org) serves HTTP/2; default first-paint-network.spec.ts to http2
    # while keeping FIRST_PAINT_PROTOCOL=http1 (or both) selectable (#573).
    local first_paint_protocol="${FIRST_PAINT_PROTOCOL:-http2}"
    mkdir -p "$CARGO_TARGET_DIR"

    report_environment() {
        local rtt="${INFRATERNAL_TEST_RTT:-300}"
        local jitter=30
        [[ "$rtt" == 0 ]] && jitter=0
        printf 'ENVIRONMENT phase=%s machine=%s arch=%s cores=%s load=%s tracer_test_port=%s rtt_ms=%s jitter_ms=%s first_paint_protocol=%s\n' \
            "$1" "$(uname -n)" "$(uname -m)" "$(getconf _NPROCESSORS_ONLN)" "$(cut -d' ' -f1-3 /proc/loadavg)" \
            "$TRACER_TEST_PORT" "$rtt" "$jitter" "$first_paint_protocol"
    }

    report_environment setup

    python3 "${script_dir}/latency_proxy.py" self-test --samples 31 || failed=1
    # The host's own target: the native rows run the agent, so they need a binary this
    # machine executes (the profile runs on compute01 x86_64 and dev-02 aarch64).
    local native_target="$(uname -m)-unknown-linux-musl"
    if [[ -n "${INFRATERNAL_LATENCY_BINARY:-}" ]]; then
        # A binary built elsewhere (the nightly perf-VM run, #447): measure exactly these bytes.
        report_environment native
        python3 "${script_dir}/verify-latency.py" --binary "$INFRATERNAL_LATENCY_BINARY" || failed=1
    elif scripts/static-cargo build --locked --release --package infraternal --target "$native_target"; then
        report_environment native
        python3 "${script_dir}/verify-latency.py" \
            --binary "$CARGO_TARGET_DIR/$native_target/release/infraternal" || failed=1
    else
        failed=1
    fi

    # The auth-browser check is a functional gate, not a D375 row producer, and it builds a Rust example:
    # a prebuilt-binary run (the perf VM has no cargo) leaves it to `verify fast` and the nightly suite.
    if [[ -z "${INFRATERNAL_LATENCY_BINARY:-}" ]]; then
        report_environment auth-browser
        "${script_dir}/verify-auth-browser" || failed=1
    fi
    # `set -e` does not apply inside a subshell on the left of `||`, so the steps are
    # chained: a failed install or typecheck must fail the row, not only the browser run.
    # Only the specs that print D375 rows run here; the whole functional browser suite
    # belongs to `verify fast` and the nightly, and took about 5 h on one worker (#447).
    # They run twice: unthrottled (vsync and the frame-rate limit off, so frame-bound rows
    # measure our own work; this run gates) and at headless Chromium's normal 60 Hz pacing
    # (reported beside it). The report checks the unthrottled run really ran above 60 Hz.
    local row_specs=(test/terminal.spec.ts test/latency-profile.spec.ts test/second-burst.spec.ts)
    local unthrottled_flags="--disable-renderer-backgrounding --disable-gpu-vsync --disable-frame-rate-limit"
    (
        cd -- "$repo_dir/apps/tracer" &&
            bun install --frozen-lockfile &&
            bun run check
    ) || failed=1
    report_environment tracer-browser-unthrottled
    (
        cd -- "$repo_dir/apps/tracer" &&
            INFRATERNAL_LATENCY_DISPLAY=unthrottled TRACER_CHROMIUM_FLAGS="$unthrottled_flags" \
                TRACER_TEST_PORT="$TRACER_TEST_PORT" bun x playwright test "${row_specs[@]}"
    ) || failed=1
    report_environment tracer-browser-60hz
    (
        cd -- "$repo_dir/apps/tracer" &&
            INFRATERNAL_LATENCY_DISPLAY=60hz TRACER_TEST_PORT="$TRACER_TEST_PORT" bun x playwright test "${row_specs[@]}"
    ) || failed=1
    # The rows a person sees (#569 finding 2, #573): overlapping typing into a real shell and first paint on 4G and
    # fast 3G, on the production server and a production build of the tracer. The typing spec runs unthrottled (this
    # gates: paint minus message measures our own work) and at 60 Hz (reported); first paint runs once. The server
    # is the binary measured above; RTT is the profile's own. The bridge delays in user space, so no network
    # setting on the machine changes.
    local real_binary="${INFRATERNAL_LATENCY_BINARY:-$CARGO_TARGET_DIR/$native_target/release/infraternal}"
    local one_way=$(( ${INFRATERNAL_TEST_RTT:-300} / 2 ))
    (
        cd -- "$repo_dir/apps/tracer" &&
            bun run build
    ) || failed=1
    report_environment realistic-typing-unthrottled
    (
        cd -- "$repo_dir/apps/tracer" &&
            INFRATERNAL_BIN="$real_binary" REAL_ONE_WAY_MS="$one_way" INFRATERNAL_LATENCY_DISPLAY=unthrottled \
                TRACER_CHROMIUM_FLAGS="$unthrottled_flags" \
                bun x playwright test -c playwright.real.config.ts real/realistic-typing.spec.ts
    ) || failed=1
    report_environment realistic-typing-60hz
    (
        cd -- "$repo_dir/apps/tracer" &&
            INFRATERNAL_BIN="$real_binary" REAL_ONE_WAY_MS="$one_way" \
                FIRST_PAINT_PROTOCOL="$first_paint_protocol" \
                bun x playwright test -c playwright.real.config.ts real/realistic-typing.spec.ts real/first-paint-network.spec.ts
    ) || failed=1
    report_environment finish
    return "$failed"
}

# Browser specs against the real server binary and a production build of the tracer (no test double): the canvas
# on real sessions (apps/tracer/real). INFRATERNAL_BIN overrides the binary that is built here.
verify_integration() {
    local repo_dir="$(cd -- "${script_dir}/.." && pwd)"
    local target_dir="${CARGO_TARGET_DIR:-$repo_dir/target}"
    export CARGO_TARGET_DIR="$target_dir"
    if [[ -z "${INFRATERNAL_BIN:-}" ]]; then
        scripts/static-cargo build --locked --release --package infraternal --target x86_64-unknown-linux-musl || return 1
        export INFRATERNAL_BIN="$CARGO_TARGET_DIR/x86_64-unknown-linux-musl/release/infraternal"
    fi
    # Chained for the same reason as verify_latency_steps: the caller may test this function's
    # status, which turns `set -e` off inside it.
    (
        cd -- "$repo_dir/apps/tracer" &&
            bun install --frozen-lockfile &&
            bun run check &&
            bun run build &&
            bun x playwright test -c playwright.real.config.ts
    )
}

if [[ $# -ne 1 ]]; then
    printf 'usage: scripts/verify {quick|fast|iterate|nightly|integration|browser|latency|bench}\n' >&2
    exit 2
fi

case "$1" in
    quick)
        # Pre-check before the gate (#329): never a substitute for "fast".
        verify_quick
        ;;
    fast|iterate)
        # "fast" is the full final gate. "iterate" is the cheaper loop for use
        # between commits: identical checks minus the two static release
        # builds, linkage, key-heap and size checks (see rust_verify_fast).
        # Run "fast" before reporting work done.
        mode=final
        [[ "$1" == iterate ]] && mode=iterate
        printf '\n==> Repository artifact size gate\n'
        python3 "${script_dir}/verify.d/evidence-size.py"
        printf '\n==> Release deployment functional checks\n'
        python3 "${script_dir}/release/deploy_test.py"
        python3 "${script_dir}/release/staging_artifacts_test.py"
        bun test "${script_dir}/release/deploy-review.test.ts"
        python3 "${script_dir}/latency_proxy.py" self-test --samples 3 --forwarding-only
        rust_verify_fast "$mode"
        ts_verify_fast
        if [[ "$mode" == iterate ]]; then
            printf '\nITERATE gate passed. This is not the final gate: run scripts/verify fast before reporting done.\n'
        fi
        ;;
    nightly)
        # The ordinary workspace gate already runs the 1k smoke corpus.
        # Nightly uses optimized Rust/native code for all 20k deterministic
        # cases, with safe console output even when an assertion fails.
        vt_nightly_corpus() {
            # Fresh C and RIS differ in prompt-redraw state in the pinned API.
            # Report both contexts; never hide that difference by normalization.
            for initial in RIS fresh-c; do
                VT_SNAPSHOT_INITIAL="$initial" cargo test --release --locked -p infraternal-shim --lib fidelity_seeded_nightly \
                    -- --ignored --nocapture --test-threads=1 2>&1 | tr -c '[:print:]\n' '.' || return $?
            done
            VT_SNAPSHOT_INITIAL=RIS cargo test --release --locked -p infraternal-shim --lib fidelity_extended_nightly \
                -- --ignored --nocapture --test-threads=1 2>&1 | tr -c '[:print:]\n' '.'
        }
        rust_run_gate "VT nightly corpus" vt_nightly_corpus
        rust_print_summary
        exit "$RUST_GATE_FAILED"
        ;;
    browser)
        "${script_dir}/verify-auth-browser"
        ;;
    latency)
        verify_latency
        ;;
    integration)
        verify_integration
        ;;
    bench)
        printf '%s: not yet implemented\n' "$1"
        ;;
    *)
        printf 'unknown verification mode: %s\n' "$1" >&2
        printf 'usage: scripts/verify {fast|iterate|nightly|integration|browser|latency|bench}\n' >&2
        exit 2
        ;;
esac
