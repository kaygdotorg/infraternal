#!/usr/bin/env bash
# Dispatch repository verification modes and report which gate is not ready yet.
set -euo pipefail

# Nix hosts may expose Rust but omit OpenSSL's native build drivers. CI installs
# these explicitly; the documented Nix invocation supplies them here when absent.
if ! command -v make >/dev/null || ! command -v perl >/dev/null; then
    if command -v nix >/dev/null; then
        exec nix shell nixpkgs#gnumake nixpkgs#perl -c "$0" "$@"
    fi
    printf 'verify requires make and perl for vendored OpenSSL
' >&2
    exit 1
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "${script_dir}/verify.d/rust.sh"
source "${script_dir}/verify.d/ts.sh"

if [[ $# -ne 1 ]]; then
    printf 'usage: scripts/verify {fast|integration|browser|bench}\n' >&2
    exit 2
fi

case "$1" in
    fast)
        rust_verify_fast
        ts_verify_fast
        ;;
    browser)
        "${script_dir}/verify-auth-browser"
        ;;
    integration|bench)
        printf '%s: not yet implemented\n' "$1"
        ;;
    *)
        printf 'unknown verification mode: %s\n' "$1" >&2
        printf 'usage: scripts/verify {fast|integration|browser|bench}\n' >&2
        exit 2
        ;;
esac
