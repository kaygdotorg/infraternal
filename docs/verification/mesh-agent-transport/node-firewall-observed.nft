			     fde0:e22b:1df5::3c1,
			     fde0:e22b:1df5::3c2,
			     fde0:e22b:1df5::3c3,
			     fde0:e22b:1df5::3c4,
			     fde0:e22b:1df5::3c5,
			     fde0:e22b:1df5::3c6,
			     fde0:e22b:1df5::3c7,
			     fde0:e22b:1df5::3c8,
			     fde0:e22b:1df5::3c9,
			     fde0:e22b:1df5::3ca,
			     fde0:e22b:1df5::3cb,
			     fde0:e22b:1df5::3cc,
			     fde0:e22b:1df5::3cd,
			     fde0:e22b:1df5::3ce,
			     fde0:e22b:1df5::3cf,
			     fde0:e22b:1df5::3d0,
			     fde0:e22b:1df5::3d1,
			     fde0:e22b:1df5::3d2,
			     fde0:e22b:1df5::3d3,
			     fde0:e22b:1df5::3d4,
			     fde0:e22b:1df5::3d5,
			     fde0:e22b:1df5::3d6,
			     fde0:e22b:1df5::3d7,
			     fde0:e22b:1df5::3d8,
			     fde0:e22b:1df5::3d9,
			     fde0:e22b:1df5::3da,
			     fde0:e22b:1df5::3db,
			     fde0:e22b:1df5::3dc,
			     fde0:e22b:1df5::3dd,
			     fde0:e22b:1df5::3de,
			     fde0:e22b:1df5::3df,
			     fde0:e22b:1df5::3e0,
			     fde0:e22b:1df5::3e1,
			     fde0:e22b:1df5::3e2,
			     fde0:e22b:1df5::3e3,
			     fde0:e22b:1df5::3e4,
			     fde0:e22b:1df5::3e5,
			     fde0:e22b:1df5::3e6,
			     fde0:e22b:1df5::3e7 }
	}

	set outgoing6_tcp {
		type ipv6_addr . inet_service
	}

	set outgoing6_udp {
		type ipv6_addr . inet_service
	}

	chain incoming {
		ct state established,related accept
		ip saddr @incoming4_all accept
		ip saddr . tcp dport @incoming4_tcp accept
		ip saddr . udp dport @incoming4_udp accept
		ip6 saddr @incoming6_all accept
		ip6 saddr . tcp dport @incoming6_tcp accept
		ip6 saddr . udp dport @incoming6_udp accept
		drop
	}

	chain outgoing {
		ct state established,related accept
		ip daddr @outgoing4_all accept
		ip daddr . tcp dport @outgoing4_tcp accept
		ip daddr . udp dport @outgoing4_udp accept
		ip6 daddr @outgoing6_all accept
		ip6 daddr . tcp dport @outgoing6_tcp accept
		ip6 daddr . udp dport @outgoing6_udp accept
		drop
	}

	chain input {
		type filter hook input priority filter - 10; policy accept;
		iifname "infraternal0" jump incoming
	}

	chain output {
		type filter hook output priority filter - 10; policy accept;
		oifname "infraternal0" jump outgoing
	}

	chain forward {
		type filter hook forward priority filter - 10; policy accept;
		iifname "infraternal0" drop
		oifname "infraternal0" drop
	}

	chain ingress {
		type filter hook prerouting priority raw - 10; policy accept;
		iifname != { "lo", "infraternal0" } ip daddr 10.254.3.232 drop
		iifname != { "lo", "infraternal0" } ip6 daddr fde0:e22b:1df5::3e8 drop
	}
}
