+    /// Clock steps must not suppress or burst congestion signals on fresh stamps.
+    #[test]
+    fn j881_clock_steps_with_fresh_stamps_reset_deadlines() {
+        let cfg = ecn_1_10();
+        let epoch = 1_800_000_000_000_000_000;
+        let mut errors = Vec::new();
+        for ecn in [0, 2] {
+        for shift_ms in [0_i64, -3_600_000, 3_600_000] {
+            let mut codel = Codel::default();
+            let (before, now) = drive_bulk(&mut codel, &cfg, 1, ecn, epoch, 200);
+            assert!(before[0].iter().any(|&v| v != Verdict::Pass));
+            let shift = shift_ms.unsigned_abs() * MS;
+            let after = if shift_ms < 0 { now - shift } else { now + shift };
+            let mut p = tcp_v4(40_000, ecn, 1400);
+            let first = judge_with(&mut codel, &mut p, after - 3*MS, after, &cfg);
+            let mut signals = 0;
+            for step in 1..=100_000u64 {
+                let at = after + step * 10_000;
+                let age = 3 * MS + step * 1_000;
+                let mut p = tcp_v4(40_000, ecn, 1400);
+                signals += usize::from(judge_with(&mut codel, &mut p, at-age, at, &cfg) != Verdict::Pass);
+            }
+            eprintln!("J881 fresh stamps ecn={ecn} shift_ms={shift_ms} first={first:?} signals={signals}/100000");
+            if signals == 0 || signals == 100_000 { errors.push((ecn, shift_ms)); }
+        }
+        }
+        assert!(errors.is_empty(), "post-step episodes retained old deadlines: {errors:?}");
+    }
