+  /** Updates indexed or default colors locally, without feeding bytes into the VT stream. */
+  setThemeColor(index: number, rgb: number): void {
+    if (!Number.isInteger(index) || index < 0 || index > 18) {
+      throw new RangeError('Theme color index must be between 0 and 18');
+    }
+    if (!Number.isInteger(rgb) || rgb < 0 || rgb > 0x00ff_ffff) {
+      throw new RangeError('Theme color must be packed 0xRRGGBB');
+    }
+    this.exports.ghostty_terminal_set_theme_color(this.handle, index, rgb);
+  }
