+  /** Stores visible underline ranges for a separate paint pass after affected rows render. */
+  public setHoveredLinkRanges(
+    ranges: readonly { startX: number; startY: number; endX: number; endY: number }[] | null
+  ): void {
+    const next = ranges?.length ? ranges.map((range) => ({ ...range })) : null;
+    if (sameLinkRanges(this.hoveredLinkRanges, next)) return;
+    this.hoveredLinkRanges = next;
+  }
+
+  private renderHoveredLinkRangesForRow(row: number, cols: number): void {
+    const ranges = this.hoveredLinkRanges;
+    if (!ranges) return;
+    this.ctx.save();
+    this.ctx.globalAlpha = 1;
+    this.ctx.strokeStyle = this.theme.cursor;
+    this.ctx.lineWidth = 1;
+    for (const range of ranges) {
+      if (row < range.startY || row > range.endY) continue;
+      const firstColumn = Math.max(0, row === range.startY ? range.startX : 0);
+      const lastColumn = Math.min(cols - 1, row === range.endY ? range.endX : cols - 1);
+      if (lastColumn < firstColumn) continue;
+      const underlineY = row * this.metrics.height + this.metrics.baseline + 2;
+      this.ctx.beginPath();
+      this.ctx.moveTo(firstColumn * this.metrics.width, underlineY);
+      this.ctx.lineTo((lastColumn + 1) * this.metrics.width, underlineY);
+      this.ctx.stroke();
+    }
+    this.ctx.restore();
