+/** Link ranges compare by coordinates so repeated pointer events do not redraw a stable underline. */
+function sameLinkRanges(
+  left: readonly { startX: number; startY: number; endX: number; endY: number }[] | null,
+  right: readonly { startX: number; startY: number; endX: number; endY: number }[] | null,
+): boolean {
+  if (left === right) return true;
+  if (!left || !right || left.length !== right.length) return false;
+  return left.every((range, index) => {
+    const other = right[index];
+    return other !== undefined && range.startX === other.startX && range.startY === other.startY &&
+      range.endX === other.endX && range.endY === other.endY;
+  });
