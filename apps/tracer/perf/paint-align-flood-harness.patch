+  async floodForTest(options: { bytesPerSecond: number; durationMs: number }): Promise<{ bytes: number; stalls: number; renderPasses: number; messages: number }> {
+    const self = this as unknown as { sendFrame: (id: number, frame: { type: string }) => void };
+    const originalSend = self.sendFrame.bind(this);
+    self.sendFrame = (id, frame) => { if (frame.type !== "Credit" && frame.type !== "Input") originalSend(id, frame); };
+    const line = new TextEncoder().encode(`${"x".repeat(78)}\r\n`);
